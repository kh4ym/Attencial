@using System.Net.Http.Headers
@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@implements IDisposable

<header class="navbar-glass">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <a href="/" class="navbar-brand-custom">
            <i class="bi bi-eye-fill"></i> Attencial
        </a>

        <nav class="d-flex align-items-center gap-2">
            <a href="" class="nav-link-custom @GetActiveStyle("")">
                <i class="bi bi-house-door-fill"></i> Home
            </a>

            @if (isLoggedIn)
            {
                <a href="dashboard" class="nav-link-custom @GetActiveStyle("dashboard")">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>

                @if (userRole == "Professor")
                {
                    <a href="session" class="nav-link-custom @GetActiveStyle("session")">
                        <i class="bi bi-play-circle-fill"></i> Start Session
                    </a>
                    <a href="faculty/check-in" class="nav-link-custom @GetActiveStyle("faculty/check-in")">
                        <i class="bi bi-shield-lock-fill"></i> Faculty HR
                    </a>
                    <a href="leave-requests" class="nav-link-custom @GetActiveStyle("leave-requests")">
                        <i class="bi bi-calendar-range-fill"></i> Leave Requests
                    </a>
                    <a href="admin/leave-review" class="nav-link-custom @GetActiveStyle("admin/leave-review")">
                        <i class="bi bi-shield-check"></i> Review Leaves
                    </a>
                    <a href="enrollment-review" class="nav-link-custom @GetActiveStyle("enrollment-review")">
                        <i class="bi bi-person-check-fill"></i> Enrollments
                    </a>
                    <a href="professor-dashboard" class="nav-link-custom @GetActiveStyle("professor-dashboard")">
                        <i class="bi bi-graph-up"></i> Analytics
                    </a>
                }
                else
                {
                    <a href="courses" class="nav-link-custom @GetActiveStyle("courses")">
                        <i class="bi bi-journals"></i> My Courses
                    </a>
                    <a href="enroll" class="nav-link-custom @GetActiveStyle("enroll")">
                        <i class="bi bi-person-bounding-box"></i> Enroll Face
                    </a>
                }

                <button @onclick="Logout" class="btn-premium-outline ms-2">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            }
            else
            {
                <a href="login" class="nav-link-custom @GetActiveStyle("login")">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
                <a href="register" class="btn-premium text-decoration-none">
                    <i class="bi bi-person-plus-fill"></i> Sign Up
                </a>
            }
        </nav>
    </div>
</header>

@code {
    private bool isLoggedIn = false;
    private string userRole = string.Empty;
    private string currentUri = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        currentUri = Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;

        var token = await JS.InvokeAsync<string>("authStorage.getToken");
        isLoggedIn = !string.IsNullOrEmpty(token) && token != "null" && token != "undefined";

        if (isLoggedIn)
            await LoadRole(token);
    }

    private async Task LoadRole(string token)
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, "api/auth/me");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                userRole = doc.RootElement.GetProperty("data").GetProperty("role").GetString() ?? string.Empty;
            }
        }
        catch { /* silently ignore — nav degrades gracefully */ }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUri = Nav.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private string GetActiveStyle(string path)
    {
        var cleanUri = currentUri.Split('?')[0];
        return cleanUri.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("authStorage.removeToken");
        isLoggedIn = false;
        userRole = string.Empty;
        Nav.NavigateTo("", true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}

