@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<div class="app-container">
    @if (!isAuthPage)
    {
        <NavMenu />
    }
    
    <main class="@(isAuthPage ? "" : "main-content")">
        @Body
    </main>
</div>

@code {
    private bool isAuthPage = false;

    protected override void OnInitialized()
    {
        UpdatePageType(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePageType(e.Location);
        StateHasChanged();
    }

    private void UpdatePageType(string uri)
    {
        var relativePath = Nav.ToBaseRelativePath(uri).Split('?')[0].ToLower();
        isAuthPage = relativePath == "login" || relativePath == "register";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
