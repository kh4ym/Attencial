@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        @* Full layout with sidebar for authenticated users *@
        <div class="app-shell">
            <aside class="sidebar">
                <NavMenu />
            </aside>
            <div class="main-area">
                <header class="topbar">
                    <div class="topbar-left">
                        <span class="app-title">Attencial</span>
                    </div>
                    <div class="topbar-right">
                        <span class="user-email">@context.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</span>
                    </div>
                </header>
                <main class="page-content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        @* Minimal layout (no sidebar) for login/register pages *@
        <div class="auth-shell">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>