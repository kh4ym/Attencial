@page "/session"
@implements IDisposable
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@using System.Text.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Start Session — Attencial</PageTitle>

@if (!isAuthorized)
{
    <div class="text-center py-5 animate-fade-in">
        <div class="spinner-premium"></div>
        <p class="text-muted">Checking authorization...</p>
    </div>
}
else if (isProfileMissing)
{
    @* ── PROFILE SEEDING CARD ── *@
    <div class="row justify-content-center animate-fade-in py-5">
        <div class="col-md-6">
            <div class="feature-card-soft p-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--colors-hairline); border-radius: var(--rounded-lg);">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 animate-float"
                         style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(230, 0, 35, 0.1) !important; color: var(--colors-primary) !important;">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Complete Professor Profile</h4>
                    <p class="text-muted small">You need a professor profile to create attendance sessions. Fill in your details below to create one instantly.</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-glass mb-4 d-flex align-items-start gap-2 animate-fade-in">
                        <i class="bi bi-exclamation-triangle-fill mt-1" style="color: var(--colors-primary);"></i>
                        <span class="small">@errorMessage</span>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold mb-2">FULL NAME</label>
                    <input type="text" class="form-input-dark" @bind="newProfFullName" placeholder="e.g. Dr. Jane Smith" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold mb-2">DEPARTMENT</label>
                    <input type="text" class="form-input-dark" @bind="newProfDepartment" placeholder="e.g. Computer Science" />
                </div>

                <button class="btn-premium w-100" @onclick="CreateProfessorProfile" disabled="@(isCreatingProfile || string.IsNullOrWhiteSpace(newProfFullName) || string.IsNullOrWhiteSpace(newProfDepartment))">
                    @if (isCreatingProfile)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Creating Profile...</span>
                    }
                    else
                    {
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Create Profile</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
else if (activeSession is null)
{
    @* ── SETUP PANEL ── *@
    <div class="animate-fade-in">
        <div class="mb-4">
            <p class="text-muted mb-1" style="font-size: 14px; font-weight: 600;">
                <span class="live-pulse"></span> Session Control
            </p>
            <h2 class="display-lg mb-1">Start Attendance Session</h2>
            <p class="text-muted fs-6">Select a course, set expiry, and generate a QR code for students to scan.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-glass mb-4 d-flex align-items-start gap-2 animate-fade-in">
                <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                <span class="small">@errorMessage</span>
            </div>
        }

        <div class="row g-4">
            @* Left: controls *@
            <div class="col-md-5">
                <div class="feature-card-soft h-100">
                    <h5 class="heading-md mb-4">
                        <i class="bi bi-sliders" style="color: var(--colors-primary);"></i> Session Settings
                    </h5>

                    @* Course selector *@
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold mb-2">SELECT COURSE</label>
                        @if (courses.Count == 0)
                        {
                            <div class="alert-glass d-flex flex-column gap-3 p-3 animate-fade-in" style="font-size: 13px;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill" style="color: var(--colors-focus-outer);"></i>
                                    <span>No courses assigned to your profile yet.</span>
                                </div>
                                <div class="border-top pt-3 border-secondary" style="border-top-style: dashed !important;">
                                    <h6 class="small fw-semibold mb-2">Create your first course:</h6>
                                    <div class="mb-2">
                                        <label class="text-muted small mb-1">Course Code</label>
                                        <input type="text" class="form-input-dark py-1" @bind="newCourseCode" placeholder="e.g. CS-401" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="text-muted small mb-1">Course Name</label>
                                        <input type="text" class="form-input-dark py-1" @bind="newCourseName" placeholder="e.g. Software Engineering" />
                                    </div>
                                    <button class="btn-premium py-1 px-3 w-100" @onclick="CreateCourse" disabled="@(isCreatingCourse || string.IsNullOrWhiteSpace(newCourseCode) || string.IsNullOrWhiteSpace(newCourseName))">
                                        @if (isCreatingCourse)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-plus-circle"></i>
                                        }
                                        Create Course
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <select id="courseSelect" class="form-select form-select-dark" @bind="selectedCourseId">
                                <option value="0">— Choose a course —</option>
                                @foreach (var c in courses)
                                {
                                    <option value="@c.Id">@c.CourseCode — @c.Name</option>
                                }
                            </select>
                            
                            @if (!showAddCourseForm)
                            {
                                <button class="btn btn-link btn-sm p-0 text-decoration-none mt-2" style="color: var(--colors-primary); font-size: 13px;" @onclick="() => showAddCourseForm = true">
                                    <i class="bi bi-plus-circle"></i> Create Another Course
                                </button>
                            }
                            else
                            {
                                <div class="alert-glass d-flex flex-column gap-3 p-3 mt-3 animate-fade-in" style="font-size: 13px;">
                                    <h6 class="small fw-semibold mb-0">Create New Course</h6>
                                    <div class="mb-2">
                                        <label class="text-muted small mb-1">Course Code</label>
                                        <input type="text" class="form-input-dark py-1" @bind="newCourseCode" placeholder="e.g. CS-401" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="text-muted small mb-1">Course Name</label>
                                        <input type="text" class="form-input-dark py-1" @bind="newCourseName" placeholder="e.g. Software Engineering" />
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn-premium py-1 px-3 flex-grow-1" @onclick="CreateCourse" disabled="@(isCreatingCourse || string.IsNullOrWhiteSpace(newCourseCode) || string.IsNullOrWhiteSpace(newCourseName))">
                                            @if (isCreatingCourse)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <span>Create</span>
                                            }
                                        </button>
                                        <button class="btn btn-secondary btn-sm" style="font-size: 12px; background: rgba(255,255,255,0.08); color: white; border: 1px solid var(--colors-hairline);" @onclick="() => { showAddCourseForm = false; newCourseCode = string.Empty; newCourseName = string.Empty; }">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @* Expiry picker *@
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold mb-2">SESSION DURATION</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var min in new[] { 5, 10, 15, 30 })
                            {
                                <button class="expiry-pill @(selectedExpiry == min ? "expiry-pill-active" : "")"
                                        @onclick="() => selectedExpiry = min">
                                    @min min
                                </button>
                            }
                        </div>
                    </div>

                    <button class="btn-premium w-100" @onclick="StartSession" disabled="@(isStarting || selectedCourseId == 0)">
                        @if (isStarting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Starting...</span>
                        }
                        else
                        {
                            <i class="bi bi-play-circle-fill"></i>
                            <span>Start Session</span>
                        }
                    </button>
                </div>
            </div>

            @* Right: info panel *@
            <div class="col-md-7">
                <div class="feature-card-soft h-100 d-flex flex-column align-items-center justify-content-center text-center"
                     style="min-height: 320px;">
                    <div style="font-size: 4rem; opacity: 0.15; margin-bottom: 12px;">
                        <i class="bi bi-qr-code"></i>
                    </div>
                    <p class="text-muted" style="font-size: 14px; max-width: 260px;">
                        Your QR code and attendance link will appear here after you start the session.
                    </p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ── ACTIVE SESSION PANEL ── *@
    <div class="animate-fade-in">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <p class="text-muted mb-1" style="font-size: 14px; font-weight: 600;">
                    <span class="live-pulse"></span> Live Session
                </p>
                <h2 class="display-lg mb-1">@activeSession.CourseName</h2>
                <p class="text-muted fs-6">@activeSession.CourseCode &nbsp;·&nbsp; Session #@activeSession.SessionId</p>
            </div>
            <button class="btn-danger-outline" @onclick="EndSession" disabled="@isEnding">
                @if (isEnding)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-stop-circle-fill"></i>
                }
                End Session
            </button>
        </div>

        @* Countdown banner *@
        <div class="countdown-banner mb-4 animate-fade-in @(secondsLeft <= 60 ? "countdown-urgent" : "")">
            <div class="d-flex align-items-center gap-3 justify-content-between flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-hourglass-split fs-5"></i>
                    <span class="fw-semibold">Time Remaining</span>
                </div>
                <div class="countdown-digits" id="countdownDisplay">
                    @FormatTime(secondsLeft)
                </div>
                <div>
                    @if (!activeSession.IsActive || secondsLeft <= 0)
                    {
                        <span class="badge-custom" style="background: rgba(220,53,69,0.12); color: #dc3545;">
                            <i class="bi bi-x-circle-fill"></i> Expired
                        </span>
                    }
                    else
                    {
                        <span class="badge-custom badge-success">
                            <span class="live-pulse"></span> Active
                        </span>
                    }
                </div>
            </div>

            @if (secondsLeft > 0)
            {
                <div class="countdown-bar-track mt-3">
                    <div class="countdown-bar-fill" style="width: @CountdownPercent()%;"></div>
                </div>
            }
        </div>

        @if (!activeSession.IsActive || secondsLeft <= 0)
        {
            <div class="alert-glass mb-4 d-flex align-items-center gap-2 animate-fade-in">
                <i class="bi bi-clock-history"></i>
                <span>This session has expired. Students can no longer mark attendance.</span>
            </div>
            <button class="btn-premium" @onclick="ResetToSetup">
                <i class="bi bi-plus-circle-fill"></i> Start New Session
            </button>
        }
        else
        {
            <div class="row g-4">
                @* Left: QR code & Link info *@
                <div class="col-md-5 d-flex flex-column gap-4 animate-slide-up">
                    <div class="feature-card-soft text-center">
                        <h5 class="heading-md mb-3" style="font-family: 'Manrope', sans-serif; font-weight: 700;">
                            <i class="bi bi-qr-code-scan" style="color: var(--colors-primary); margin-right: 6px;"></i> Student QR Code
                        </h5>
                        <p class="text-muted small mb-3">Students scan this with their device to verify their face and check in.</p>

                        <div class="qr-wrapper mx-auto mb-3" id="qrContainer" style="padding: 12px; background: white; border-radius: var(--rounded-md); display: inline-block;">
                            @* QR renders here via JS *@
                        </div>

                        <p class="text-muted" style="font-size: 11px;">Expires in @activeSession.ExpiryMinutes min from creation</p>
                    </div>

                    @* Copy link card *@
                    <div class="feature-card-soft">
                        <h5 class="heading-md mb-2" style="font-family: 'Manrope', sans-serif; font-weight: 700;">
                            <i class="bi bi-link-45deg" style="color: var(--colors-focus-outer); margin-right: 6px;"></i> Attendance Link
                        </h5>
                        <p class="text-muted small mb-3">Share this link with students who cannot scan the QR code.</p>
                        <div class="token-display mb-3">
                            <code class="text-break" style="font-size: 11px; word-break: break-all;">@activeSession.AttendanceUrl</code>
                        </div>
                        <button class="btn-premium-outline w-100" @onclick="CopyLink">
                            <i class="bi bi-@(linkCopied ? "check2" : "clipboard")"></i>
                            @(linkCopied ? "Copied Link!" : "Copy Link")
                        </button>
                    </div>
                </div>

                @* Right: Live Attendance Dashboard *@
                <div class="col-md-7 animate-slide-up" style="animation-delay: 0.1s;">
                    <div class="feature-card-soft d-flex flex-column h-100" style="min-height: 480px;">
                        
                        @* Header and Connection Status *@
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                            <h5 class="heading-md mb-0" style="font-family: 'Manrope', sans-serif; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-broadcast-pin" style="color: var(--colors-primary); font-size: 1.2rem;"></i> Live Attendance Feed
                            </h5>
                            
                            @if (realtimeStatus == "connected")
                            {
                                <span class="badge-custom" style="background: rgba(46, 204, 113, 0.1); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.2);">
                                    <span class="live-pulse" style="background: #2ecc71;"></span> Supabase Realtime
                                </span>
                            }
                            else if (realtimeStatus == "simulated")
                            {
                                <span class="badge-custom" style="background: rgba(241, 196, 15, 0.1); color: #f1c40f; border: 1px solid rgba(241, 196, 15, 0.2);">
                                    <span class="live-pulse" style="background: #f1c40f;"></span> Local Simulation
                                </span>
                            }
                            else
                            {
                                <span class="badge-custom" style="background: rgba(230, 0, 35, 0.1); color: var(--colors-primary); border: 1px solid rgba(230, 0, 35, 0.2);">
                                    <span class="spinner-border spinner-border-sm" style="font-size: 10px; width: 10px; height: 10px; color: var(--colors-primary); border-width: 1.5px; margin-right: 4px;"></span> Connecting...
                                </span>
                            }
                        </div>

                        @* Stats Banner *@
                        <div class="d-flex justify-content-between align-items-center p-3 mb-4" 
                             style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md);">
                            <div>
                                <p class="text-muted small fw-semibold mb-1" style="letter-spacing: 0.05em;">CLASS SIZE & ENGAGEMENT</p>
                                <h3 class="fw-bold mb-0" style="color: white; font-family: 'Manrope', sans-serif;">
                                    @presentStudents.Count <span class="text-muted" style="font-size: 1.1rem; font-weight: 500;">/ @enrolledStudents.Count present</span>
                                </h3>
                            </div>
                            
                            <div class="text-end">
                                <span class="fw-bold fs-4" style="color: #2ecc71; font-family: 'Manrope', sans-serif;">
                                    @(enrolledStudents.Count > 0 ? $"{(int)((double)presentStudents.Count / enrolledStudents.Count * 100)}%" : "0%")
                                </span>
                            </div>
                        </div>

                        @* Feed Log List *@
                        <div class="flex-grow-1" style="max-height: 280px; overflow-y: auto; padding-right: 4px;">
                            @if (presentStudents.Count == 0)
                            {
                                <div class="text-center py-5" style="opacity: 0.5;">
                                    <i class="bi bi-people-fill text-muted mb-2" style="font-size: 2.2rem; display: block;"></i>
                                    <p class="text-muted small mb-0">Waiting for students to check in...</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var record in presentStudents)
                                    {
                                        <div class="d-flex align-items-center justify-content-between p-3 animate-slide-up"
                                             style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--colors-hairline); border-radius: var(--rounded-sm); transition: transform 0.2s;">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                     style="width: 36px; height: 36px; background: rgba(46, 204, 113, 0.1); color: #2ecc71;">
                                                    <i class="bi bi-person-check-fill"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-semibold mb-0" style="color: white; font-size: 14px;">@record.StudentName</h6>
                                                    <span class="text-muted" style="font-size: 12px;">Roll: @record.RollNumber</span>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-semibold mb-1" style="font-size: 13px; color: #2ecc71;">
                                                    <i class="bi bi-shield-check"></i> @(record.Confidence == 100.0 ? "Verified" : $"{record.Confidence:F1}% Match")
                                                </div>
                                                <span class="text-muted" style="font-size: 11px;">
                                                    <i class="bi bi-clock"></i> @FormatMarkedTime(record.MarkedAt)
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    // ── State ──────────────────────────────────────────────────────────────────
    private bool isAuthorized = false;
    private string? errorMessage;
    private bool isStarting = false;
    private bool isEnding = false;
    private bool linkCopied = false;

    private int selectedCourseId = 0;
    private int selectedExpiry = 15;

    private List<CourseItem> courses = new();
    private SessionResponseDto? activeSession;

    private bool isProfileMissing = false;
    private bool isCreatingProfile = false;
    private string newProfFullName = string.Empty;
    private string newProfDepartment = string.Empty;

    private bool showAddCourseForm = false;
    private bool isCreatingCourse = false;
    private string newCourseCode = string.Empty;
    private string newCourseName = string.Empty;

    // Countdown
    private int totalSeconds = 0;
    private int secondsLeft = 0;
    private System.Threading.Timer? _countdownTimer;

    // Realtime & Simulation state
    private List<PresentRecord> presentStudents = new();
    private List<EnrolledStudent> enrolledStudents = new();
    private string realtimeStatus = "Connecting...";
    private DotNetObjectReference<Session>? _selfReference;

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("authStorage.getToken");
        if (string.IsNullOrEmpty(token) || token == "null")
        {
            Nav.NavigateTo("/login");
            return;
        }
        isAuthorized = true;
        await LoadCourses(token);
    }

    private async Task LoadCourses(string token)
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, "api/attendance/professor/courses");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                isProfileMissing = false;
                errorMessage = null;
                var json = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                courses = new();
                foreach (var item in data.EnumerateArray())
                {
                    courses.Add(new CourseItem
                    {
                        Id         = item.GetProperty("id").GetInt32(),
                        Name       = item.GetProperty("name").GetString() ?? "",
                        CourseCode = item.GetProperty("courseCode").GetString() ?? ""
                    });
                }
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "Access denied (403). Your account role is not 'Professor'. " +
                               "Register with role=\"Professor\" or check your JWT token.";
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                isProfileMissing = true;
                errorMessage = "No professor profile found (404). Complete your profile below to get started.";
            }
            else
            {
                errorMessage = $"Server returned {(int)res.StatusCode} {res.StatusCode}. Check the API console for details.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading courses: {ex.Message}";
        }
    }

    // ── Start Session ──────────────────────────────────────────────────────────
    private async Task StartSession()
    {
        if (selectedCourseId == 0) return;
        isStarting = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var jwtToken = await JS.InvokeAsync<string>("authStorage.getToken");
            var req = new HttpRequestMessage(HttpMethod.Post, "api/attendance/sessions");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", jwtToken);
            req.Content = JsonContent.Create(new CreateSessionRequest
            {
                CourseId      = selectedCourseId,
                ExpiryMinutes = selectedExpiry
            });

            var res = await Http.SendAsync(req);
            var body = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(body);
                var data = doc.RootElement.GetProperty("data");
                activeSession = new SessionResponseDto
                {
                    SessionId     = data.GetProperty("sessionId").GetInt32(),
                    CourseId      = data.GetProperty("courseId").GetInt32(),
                    CourseName    = data.GetProperty("courseName").GetString() ?? "",
                    CourseCode    = data.GetProperty("courseCode").GetString() ?? "",
                    Token         = data.GetProperty("token").GetString() ?? "",
                    ExpiryMinutes = data.GetProperty("expiryMinutes").GetInt32(),
                    ExpiresAt     = data.GetProperty("expiresAt").GetDateTime(),
                    IsActive      = data.GetProperty("isActive").GetBoolean(),
                    AttendanceUrl = data.GetProperty("attendanceUrl").GetString() ?? ""
                };

                // Start the countdown
                totalSeconds = selectedExpiry * 60;
                secondsLeft  = totalSeconds;
                StartCountdown();

                // Load enrolled students, present list, and connect realtime
                await LoadEnrolledStudents(jwtToken, activeSession.CourseId);
                await LoadSessionRecords(jwtToken, activeSession.SessionId);
                await InitializeRealtime(jwtToken, activeSession.CourseId, activeSession.SessionId);
            }
            else
            {
                using var doc = JsonDocument.Parse(body);
                errorMessage = doc.RootElement.TryGetProperty("message", out var msg)
                    ? msg.GetString()
                    : $"Server error ({res.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            isStarting = false;
        }
    }

    // ── End Session ────────────────────────────────────────────────────────────
    private async Task EndSession()
    {
        if (activeSession is null) return;
        isEnding = true;
        StateHasChanged();

        try
        {
            var jwtToken = await JS.InvokeAsync<string>("authStorage.getToken");
            var req = new HttpRequestMessage(HttpMethod.Delete, $"api/attendance/sessions/{activeSession.SessionId}/end");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", jwtToken);
            await Http.SendAsync(req);

            _countdownTimer?.Dispose();
            activeSession.IsActive = false;
            secondsLeft = 0;
            await DisconnectRealtime();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error ending session: {ex.Message}";
        }
        finally
        {
            isEnding = false;
        }
    }

    private async Task ResetToSetup()
    {
        _countdownTimer?.Dispose();
        await DisconnectRealtime();
        activeSession = null;
        errorMessage = null;
        selectedCourseId = 0;
        selectedExpiry = 15;
        secondsLeft = 0;
    }

    // ── QR Code ────────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeSession is not null && activeSession.IsActive && secondsLeft > 0)
        {
            // Generate QR — safe to call multiple times, qrcode.js replaces innerHTML
            await JS.InvokeVoidAsync("attencialQr.generate", "qrContainer", activeSession.AttendanceUrl);
        }
    }

    // ── Countdown Timer ────────────────────────────────────────────────────────
    private void StartCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            secondsLeft--;
            if (secondsLeft <= 0)
            {
                secondsLeft = 0;
                _countdownTimer?.Dispose();
                if (activeSession is not null) activeSession.IsActive = false;
            }
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // ── Copy Link ──────────────────────────────────────────────────────────────
    private async Task CopyLink()
    {
        if (activeSession is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", activeSession.AttendanceUrl);
        linkCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        linkCopied = false;
        StateHasChanged();
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    private string FormatTime(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return $"{(int)ts.TotalMinutes:D2}:{ts.Seconds:D2}";
    }

    private double CountdownPercent()
    {
        if (totalSeconds == 0) return 0;
        return Math.Max(0, (double)secondsLeft / totalSeconds * 100);
    }

    private async Task CreateProfessorProfile()
    {
        if (string.IsNullOrWhiteSpace(newProfFullName) || string.IsNullOrWhiteSpace(newProfDepartment)) return;
        isCreatingProfile = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            var req = new HttpRequestMessage(HttpMethod.Post, "api/seed/create-professor-profile");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            req.Content = JsonContent.Create(new
            {
                fullName = newProfFullName.Trim(),
                department = newProfDepartment.Trim()
            });

            var res = await Http.SendAsync(req);
            var body = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                isProfileMissing = false;
                errorMessage = null;
                // Success confetti!
                await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
                // Reload courses
                await LoadCourses(token);
            }
            else
            {
                using var doc = JsonDocument.Parse(body);
                errorMessage = doc.RootElement.TryGetProperty("message", out var msg)
                    ? msg.GetString()
                    : $"Server error ({res.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating profile: {ex.Message}";
        }
        finally
        {
            isCreatingProfile = false;
        }
    }

