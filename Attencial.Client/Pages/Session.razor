    public void Dispose()
    {
        _countdownTimer?.Dispose();
        _selfReference?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("supabaseRealtime.disconnect");
        }
        catch {}
    }

    private async Task DisconnectRealtime()
    {
        try
        {
            await JS.InvokeVoidAsync("supabaseRealtime.disconnect");
            _selfReference?.Dispose();
            _selfReference = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disconnecting realtime: {ex.Message}");
        }
    }

    private async Task LoadEnrolledStudents(string token, int courseId)
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, $"api/attendance/courses/{courseId}/enrolled-students");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                enrolledStudents = new();
                foreach (var item in data.EnumerateArray())
                {
                    enrolledStudents.Add(new EnrolledStudent
                    {
                        Id = item.GetProperty("id").GetInt32(),
                        FullName = item.GetProperty("fullName").GetString() ?? "",
                        RollNumber = item.GetProperty("rollNumber").GetString() ?? ""
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading enrolled students: {ex.Message}");
        }
    }

    private async Task LoadSessionRecords(string token, int sessionId)
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, $"api/attendance/sessions/{sessionId}/records");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                presentStudents = new();
                foreach (var item in data.EnumerateArray())
                {
                    presentStudents.Add(new PresentRecord
                    {
                        StudentId = item.GetProperty("studentId").GetInt32(),
                        StudentName = item.GetProperty("studentName").GetString() ?? "",
                        RollNumber = item.GetProperty("rollNumber").GetString() ?? "",
                        Confidence = (float)item.GetProperty("confidence").GetDouble(),
                        MarkedAt = item.GetProperty("markedAt").GetDateTime()
                    });
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading records: {ex.Message}");
        }
    }

    private async Task InitializeRealtime(string token, int courseId, int sessionId)
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, "api/attendance/config/supabase-realtime");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                var url = data.GetProperty("url").GetString() ?? "";
                var anonKey = data.GetProperty("anonKey").GetString() ?? "";

                _selfReference = DotNetObjectReference.Create(this);
                
                var status = await JS.InvokeAsync<string>(
                    "supabaseRealtime.initialize",
                    url,
                    anonKey,
                    _selfReference,
                    courseId,
                    sessionId
                );

                realtimeStatus = status;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            realtimeStatus = "error";
            Console.WriteLine($"Error initializing realtime: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnAttendanceMarkedRealtime(int studentId, double confidence, string markedAtStr)
    {
        if (presentStudents.Any(p => p.StudentId == studentId)) return;

        var student = enrolledStudents.FirstOrDefault(s => s.Id == studentId);
        if (student is not null)
        {
            var record = new PresentRecord
            {
                StudentId = studentId,
                StudentName = student.FullName,
                RollNumber = student.RollNumber,
                Confidence = (float)confidence,
                MarkedAt = DateTime.TryParse(markedAtStr, out var dt) ? dt : DateTime.UtcNow
            };

            await InvokeAsync(() =>
            {
                presentStudents.Insert(0, record);
                StateHasChanged();
            });
        }
        else
        {
            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            if (activeSession is not null)
            {
                await LoadSessionRecords(token, activeSession.SessionId);
            }
        }
    }

    [JSInvokable]
    public async Task OnAttendanceMarkedSimulated(int studentId, string studentName, string rollNumber, double confidence, string markedAtStr)
    {
        if (presentStudents.Any(p => p.StudentId == studentId)) return;

        var record = new PresentRecord
        {
            StudentId = studentId,
            StudentName = studentName,
            RollNumber = rollNumber,
            Confidence = (float)confidence,
            MarkedAt = DateTime.TryParse(markedAtStr, out var dt) ? dt : DateTime.UtcNow
        };

        await InvokeAsync(() =>
        {
            presentStudents.Insert(0, record);
            StateHasChanged();
        });
    }

    private string FormatMarkedTime(DateTime markedAt)
    {
        var diff = DateTime.UtcNow - markedAt;
        if (diff.TotalSeconds < 10) return "Just now";
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        return markedAt.ToLocalTime().ToString("hh:mm tt");
    }

