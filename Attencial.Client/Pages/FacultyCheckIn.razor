@page "/faculty/check-in"
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@using System.Text.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Faculty HR Check-In — Attencial</PageTitle>

<div class="feature-card-soft animate-fade-in-scale w-100 mx-auto" style="max-width: 650px;">
    @* Title Header *@
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 animate-float"
             style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(230, 0, 35, 0.1) !important; color: var(--colors-primary) !important;">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 class="h3 fw-bold mb-1">Faculty HR Portal</h2>
        <p class="text-secondary small">Webcam face-scanning portal for check-in, check-out, and profile activation.</p>
    </div>

    @* Navigation Tabs *@
    <div class="d-flex gap-2 justify-content-center mb-4">
        <button class="expiry-pill @(activeTab == "scan" ? "expiry-pill-active" : "")" @onclick='() => ChangeTab("scan")'>
            <i class="bi bi-camera-fill"></i> Check In / Out
        </button>
        <button class="expiry-pill @(activeTab == "register" ? "expiry-pill-active" : "")" @onclick='() => ChangeTab("register")'>
            <i class="bi bi-person-bounding-box"></i> Register Face
        </button>
        <button class="expiry-pill @(activeTab == "admin" ? "expiry-pill-active" : "")" @onclick='() => ChangeTab("admin")'>
            <i class="bi bi-card-checklist"></i> Review Queue
        </button>
    </div>

    @* Tab Content 1: Scan / Check In / Out *@
    @if (activeTab == "scan")
    {
        <div class="animate-fade-in">
            @if (message is not null)
            {
                @if (message.StartsWith("❌"))
                {
                    <div class="alert-glass mb-4 d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-triangle-fill mt-1" style="color: var(--colors-primary);"></i>
                        <span class="small text-start">@message.Replace("❌ ", "")</span>
                    </div>
                }
                else if (message.StartsWith("✅"))
                {
                    <div class="alert-glass-success mb-4 d-flex align-items-start gap-2 animate-scale-bounce">
                        <i class="bi bi-check-circle-fill mt-1"></i>
                        <span class="small text-start">@message.Replace("✅ ", "")</span>
                    </div>
                }
                else
                {
                    <div class="alert-glass-success mb-4 d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill mt-1"></i>
                        <span class="small text-start">@message</span>
                    </div>
                }
            }

            <div class="text-center mb-4 position-relative mx-auto" style="max-width: 400px;">
                <div class="position-relative overflow-hidden rounded-3" style="border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md); height: 300px;">
                    <video id="scanCamera" autoplay width="100%" height="100%" style="object-fit: cover; transform: scaleX(-1);"></video>
                    @if (cameraStarted && !isSubmitting)
                    {
                        <div class="camera-scan-line"></div>
                    }
                    @if (cameraStarted)
                    {
                        <div class="camera-overlay-container">
                            <svg viewBox="0 0 100 100" class="position-absolute" style="width: 190px; height: 230px; color: rgba(255, 255, 255, 0.2); pointer-events: none;">
                                <path d="M 50 15 C 32 15, 30 50, 32 70 C 35 85, 45 92, 50 92 C 55 92, 65 85, 68 70 C 70 50, 68 15, 50 15 Z" fill="none" stroke="currentColor" stroke-dasharray="3,3" stroke-width="1" />
                            </svg>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                @if (!cameraStarted)
                {
                    <button @onclick="StartCamera" class="btn-premium py-2 w-100">
                        <i class="bi bi-camera-video-fill"></i> Start Kiosk Camera
                    </button>
                }
                else
                {
                    <button @onclick="ProcessCheckIn" disabled="@isSubmitting" class="btn-premium py-2 flex-grow-1 animate-pulse-glow">
                        @if (isSubmitting && actionType == "checkin")
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Checking In...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-box-arrow-in-right"></i> Check In</span>
                        }
                    </button>
                    <button @onclick="ProcessCheckOut" disabled="@isSubmitting" class="btn-premium-outline py-2 flex-grow-1">
                        @if (isSubmitting && actionType == "checkout")
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Checking Out...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-box-arrow-left"></i> Check Out</span>
                        }
                    </button>
                }
            </div>
        </div>
    }

    @* Tab Content 2: Register Face *@
    @if (activeTab == "register")
    {
        <div class="animate-fade-in">
            @if (!isProfessor)
            {
                <div class="text-center py-5">
                    <i class="bi bi-exclamation-octagon fs-1 text-muted mb-3 d-block"></i>
                    <p class="text-secondary small mb-3">Only logged-in Professors can register their face templates.</p>
                    <button class="btn-premium py-2 px-4" @onclick='() => Nav.NavigateTo("/login")'>
                        <i class="bi bi-box-arrow-in-right"></i> Log In Now
                    </button>
                </div>
            }
            else
            {
                @if (message is not null)
                {
                    @if (message.StartsWith("❌"))
                    {
                        <div class="alert-glass mb-4 d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-triangle-fill mt-1" style="color: var(--colors-primary);"></i>
                            <span class="small text-start">@message.Replace("❌ ", "")</span>
                        </div>
                    }
                    else if (message.StartsWith("✅"))
                    {
                        <div class="alert-glass-success mb-4 d-flex align-items-start gap-2 animate-scale-bounce">
                            <i class="bi bi-check-circle-fill mt-1"></i>
                            <span class="small text-start">@message.Replace("✅ ", "")</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert-glass-success mb-4 d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle-fill mt-1"></i>
                            <span class="small text-start">@message</span>
                        </div>
                    }
                }

                <div class="text-center mb-4 position-relative mx-auto" style="max-width: 400px;">
                    <div class="position-relative overflow-hidden rounded-3" style="border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md); height: 300px;">
                        <video id="registerCamera" autoplay width="100%" height="100%" style="object-fit: cover; transform: scaleX(-1);"></video>
                        @if (cameraStarted && !isSubmitting)
                        {
                            <div class="camera-scan-line"></div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    @if (!cameraStarted)
                    {
                        <button @onclick="StartCamera" class="btn-premium py-2 w-100">
                            <i class="bi bi-camera-video-fill"></i> Open Camera
                        </button>
                    }
                    else
                    {
                        <button @onclick="RegisterProfessorFace" disabled="@isSubmitting" class="btn-premium py-2 w-100 animate-pulse-glow">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Indexing Face Template...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-cloud-arrow-up-fill text-white"></i> Register Face</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* Tab Content 3: Admin Review Queue *@
    @if (activeTab == "admin")
    {
        <div class="animate-fade-in">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="heading-md mb-0">Pending Review Shifts (<span class="text-primary">@pendingRecords.Count</span>)</h4>
                <button class="btn btn-secondary btn-sm" style="font-size: 11px; background: rgba(255,255,255,0.05); color: white; border: 1px solid var(--colors-hairline);" @onclick="LoadPendingShifts">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>

            @if (isLoadingAdmin)
            {
                <div class="text-center py-5">
                    <div class="spinner-premium"></div>
                    <p class="text-muted small mt-2 mb-0">Loading queue...</p>
                </div>
            }
            else if (pendingRecords.Count == 0)
            {
                <div class="alert-glass text-center py-4">
                    <i class="bi bi-check-circle fs-3 text-success mb-2 d-block"></i>
                    <p class="mb-0 fw-semibold">All shifts clear!</p>
                    <p class="text-muted small">No short-shift records require review.</p>
                </div>
            }
            else
            {
                <div class="table-responsive" style="border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md); background: rgba(0,0,0,0.12);">
                    <table class="table table-dark table-striped mb-0 align-middle" style="font-size: 12px;">
                        <thead>
                            <tr class="text-muted" style="font-size: 11px;">
                                <th class="border-0">Faculty</th>
                                <th class="border-0">Dept</th>
                                <th class="border-0 text-center">Check-In</th>
                                <th class="border-0 text-center">Check-Out</th>
                                <th class="border-0 text-center">Hours</th>
                                <th class="border-0 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rec in pendingRecords)
                            {
                                <tr>
                                    <td class="fw-semibold">@rec.ProfessorName</td>
                                    <td>@rec.Department</td>
                                    <td class="text-center text-muted">@rec.CheckInTime.ToLocalTime().ToString("t")</td>
                                    <td class="text-center text-muted">@rec.CheckOutTime?.ToLocalTime().ToString("t")</td>
                                    <td class="text-center fw-bold" style="color: var(--colors-focus-outer);">
                                        @(rec.HoursWorked.HasValue ? rec.HoursWorked.Value.ToString("F2") : "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger text-white px-2 py-1" style="font-size: 10px; font-weight: 500;">
                                            ShortShift
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private string activeTab = "scan";
    private bool cameraStarted = false;
    private bool isSubmitting = false;
    private bool isLoadingAdmin = false;
    private bool isProfessor = false;
    private string? message;
    private string actionType = ""; // "checkin" or "checkout"

    private List<PendingShiftDto> pendingRecords = new();

    protected override async Task OnInitializedAsync()
    {
        // Check role
        var token = await JS.InvokeAsync<string>("authStorage.getToken");
        if (!string.IsNullOrEmpty(token) && token != "null")
        {
            try
            {
                var req = new HttpRequestMessage(HttpMethod.Get, "api/seed/me");
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                var res = await Http.SendAsync(req);
                if (res.IsSuccessStatusCode)
                {
                    var json = await res.Content.ReadAsStringAsync();
                    using var doc = JsonDocument.Parse(json);
                    var data = doc.RootElement.GetProperty("data");
                    var role = data.GetProperty("role").GetString();
                    isProfessor = string.Equals(role, "Professor", StringComparison.OrdinalIgnoreCase);
                }
            }
            catch { }
        }
    }

    private async Task ChangeTab(string tab)
    {
        if (cameraStarted)
        {
            await StopCamera();
        }
        activeTab = tab;
        message = null;
        if (tab == "admin")
        {
            await LoadPendingShifts();
        }
    }

    private async Task StartCamera()
    {
        message = null;
        var cameraId = activeTab == "scan" ? "scanCamera" : "registerCamera";
        await JS.InvokeVoidAsync("cameraInterop.startCamera", cameraId);
        cameraStarted = true;
    }

    private async Task StopCamera()
    {
        try
        {
            await JS.InvokeVoidAsync("cameraInterop.stopCamera");
        }
        catch { }
        cameraStarted = false;
    }

    private async Task ProcessCheckIn()
    {
        await ProcessAttendanceAction("checkin", "api/faculty/attendance/checkin");
    }

    private async Task ProcessProcessCheckOut()
    {
        await ProcessAttendanceAction("checkout", "api/faculty/attendance/checkout");
    }

    // Workaround for razor parser issue with onclick binding
    private async Task ProcessCheckOut()
    {
        await ProcessAttendanceAction("checkout", "api/faculty/attendance/checkout");
    }

    private async Task ProcessAttendanceAction(string type, string endpoint)
    {
        if (isSubmitting) return;
        isSubmitting = true;
        actionType = type;
        message = "⏳ Verify face and logging record...";
        StateHasChanged();

        try
        {
            var base64 = await JS.InvokeAsync<string>("cameraInterop.captureFrame", activeTab == "scan" ? "scanCamera" : "registerCamera");
            if (base64.Contains(","))
            {
                base64 = base64.Split(',')[1];
            }

            var req = new FacultyFaceScanRequest { Image = base64 };
            var res = await Http.PostAsJsonAsync(endpoint, req);
            var body = await res.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (res.IsSuccessStatusCode && body != null && body.Success)
            {
                message = $"✅ {body.Message}";
                await StopCamera();
                await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
            }
            else
            {
                message = $"❌ {body?.Message ?? "Action failed. Please try again."}";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Connection error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            actionType = "";
        }
    }

    private async Task RegisterProfessorFace()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        message = "⏳ Uploading face template...";
        StateHasChanged();

        try
        {
            var base64 = await JS.InvokeAsync<string>("cameraInterop.captureFrame", "registerCamera");
            if (base64.Contains(","))
            {
                base64 = base64.Split(',')[1];
            }

            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            var req = new HttpRequestMessage(HttpMethod.Post, "api/faculty/register-face");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            req.Content = JsonContent.Create(new FacultyFaceScanRequest { Image = base64 });

            var res = await Http.SendAsync(req);
            var body = await res.Content.ReadFromJsonAsync<ApiResponse<string>>();

            if (res.IsSuccessStatusCode && body != null && body.Success)
            {
                message = "✅ Faculty face template registered and indexed in AWS Rekognition successfully!";
                await StopCamera();
                await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
            }
            else
            {
                message = $"❌ {body?.Message ?? "Registration failed."}";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Connection error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadPendingShifts()
    {
        isLoadingAdmin = true;
        pendingRecords.Clear();
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            var req = new HttpRequestMessage(HttpMethod.Get, "api/admin/faculty/pending");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ApiResponse<List<PendingShiftDto>>>();
                if (body != null && body.Success && body.Data != null)
                {
                    pendingRecords = body.Data;
                }
            }
        }
        catch { }
        finally
        {
            isLoadingAdmin = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (cameraStarted)
        {
            await StopCamera();
        }
    }

    // ── Local DTO ──────────────────────────────────────────────────────────────
    private class PendingShiftDto
    {
        public int RecordId { get; set; }
        public string ProfessorName { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public DateTime CheckInTime { get; set; }
        public DateTime? CheckOutTime { get; set; }
        public double? HoursWorked { get; set; }
        public string Status { get; set; } = string.Empty;
    }
}
