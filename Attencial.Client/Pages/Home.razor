@page "/"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Attencial — Facial Recognition Attendance System</PageTitle>

<div class="container py-5 animate-fade-in">
    <!-- Hero Section -->
    <div class="hero-section text-center mb-5">
        <h1 class="display-xl mb-3">Smart Attendance,<br />Reimagined.</h1>
        <p class="fs-5 text-secondary max-width-600 mx-auto mb-4">
            A premium, zero-fraud attendance marking system powered by AWS Rekognition. Fast, secure, and completely automated.
        </p>

        <div class="d-flex justify-content-center gap-3">
            @if (isLoggedIn)
            {
                <a href="dashboard" class="btn-premium px-4 text-decoration-none">
                    <i class="bi bi-speedometer2"></i> Open Dashboard
                </a>
                <a href="enroll" class="btn-premium-outline px-4 text-decoration-none">
                    <i class="bi bi-person-bounding-box"></i> Face Enrollment
                </a>
            }
            else
            {
                <a href="register" class="btn-premium px-4 text-decoration-none">
                    <i class="bi bi-rocket-takeoff-fill"></i> Get Started
                </a>
                <a href="login" class="btn-premium-outline px-4 text-decoration-none">
                    <i class="bi bi-box-arrow-in-right"></i> Log In
                </a>
            }
        </div>
    </div>

    <!-- Alternating Features Grid -->
    <div class="mt-5 pt-4">
        <!-- Feature 1: AWS Rekognition -->
        <div class="row align-items-center mb-5 g-4">
            <div class="col-md-6 order-md-1">
                <div class="p-2 bg-white rounded-lg" style="border-radius: var(--rounded-lg);">
                    <img src="images/aws_recognition.png" class="img-fluid" style="border-radius: var(--rounded-lg); width: 100%; object-fit: cover;" alt="AWS Rekognition Scan" />
                </div>
            </div>
            <div class="col-md-6 order-md-2">
                <div class="feature-card-soft">
                    <div class="feature-icon-wrapper">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3 class="heading-lg mb-3">AWS Rekognition</h3>
                    <p class="text-secondary mb-0">
                        Uses state-of-the-art deep learning facial comparison to match student identities with over 99% accuracy. No complex local setups, completely managed on cloud infrastructure.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 2: Anti-Spoofing -->
        <div class="row align-items-center mb-5 g-4">
            <div class="col-md-6 order-md-2">
                <div class="p-2 bg-white rounded-lg" style="border-radius: var(--rounded-lg);">
                    <img src="images/anti_spoofing.png" class="img-fluid" style="border-radius: var(--rounded-lg); width: 100%; object-fit: cover;" alt="Anti-Spoofing Profiles" />
                </div>
            </div>
            <div class="col-md-6 order-md-1">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="bi bi-camera-fill"></i>
                    </div>
                    <h3 class="heading-lg mb-3">Anti-Spoofing Protection</h3>
                    <p class="text-secondary mb-0">
                        Requires three multi-angle captures (straight, left, right) to prevent photo presentation attacks or spoofing. Ensures that the actual student is physically present.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 3: Instant Sync -->
        <div class="row align-items-center mb-5 g-4">
            <div class="col-md-6 order-md-1">
                <div class="p-2 bg-white rounded-lg" style="border-radius: var(--rounded-lg);">
                    <img src="images/instant_sync.png" class="img-fluid" style="border-radius: var(--rounded-lg); width: 100%; object-fit: cover;" alt="Instant Cloud Sync" />
                </div>
            </div>
            <div class="col-md-6 order-md-2">
                <div class="feature-card-soft">
                    <div class="feature-icon-wrapper">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h3 class="heading-lg mb-3">Instant Cloud Sync</h3>
                    <p class="text-secondary mb-0">
                        No asynchronous training. Enrolled faces are instantly indexed and searchable for attendance in under a second. Complete session management and validation at your fingertips.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoggedIn = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("authStorage.getToken");
        isLoggedIn = !string.IsNullOrEmpty(token) && token != "null" && token != "undefined";
    }
}
