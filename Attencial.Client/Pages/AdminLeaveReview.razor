@page "/admin/leave-review"
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Leave Requests Review Queue — Attencial</PageTitle>

<div class="feature-card-soft animate-fade-in-scale w-100 mx-auto" style="max-width: 800px;">
    @* Portal Header *@
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 animate-float"
             style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(230, 0, 35, 0.1) !important; color: var(--colors-primary) !important;">
            <i class="bi bi-shield-check"></i>
        </div>
        <h2 class="h3 fw-bold mb-1">Leave Review Queue</h2>
        <p class="text-secondary small">Review pending leave applications from faculty members.</p>
    </div>

    @* Alerts *@
    @if (message is not null)
    {
        @if (message.StartsWith("❌"))
        {
            <div class="alert-glass mb-4 d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-triangle-fill mt-1" style="color: var(--colors-primary);"></i>
                <span class="small text-start">@message.Replace("❌ ", "")</span>
            </div>
        }
        else if (message.StartsWith("✅"))
        {
            <div class="alert-glass-success mb-4 d-flex align-items-start gap-2 animate-scale-bounce">
                <i class="bi bi-check-circle-fill mt-1"></i>
                <span class="small text-start">@message.Replace("✅ ", "")</span>
            </div>
        }
        else
        {
            <div class="alert-glass mb-4 d-flex align-items-start gap-2">
                <i class="bi bi-info-circle-fill mt-1"></i>
                <span class="small text-start">@message</span>
            </div>
        }
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-premium"></div>
            <p class="text-muted small mt-2">Loading pending reviews...</p>
        </div>
    }
    else if (pendingRequests.Count == 0)
    {
        <div class="alert-glass text-center py-5">
            <i class="bi bi-emoji-smile fs-1 text-success mb-3 d-block"></i>
            <h4 class="fw-bold text-white mb-1">All Clear!</h4>
            <p class="text-muted small mb-0">No pending leave requests found in the review queue.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var req in pendingRequests)
            {
                <div class="alert-glass p-4 animate-fade-in" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md);">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <h4 class="fw-bold fs-5 text-white mb-1">@req.ProfessorName</h4>
                            <span class="badge bg-secondary px-2 py-1 text-white" style="font-size: 10px;">@req.Department</span>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 10px; font-weight: 500;">
                                @req.LeaveType Leave
                            </span>
                            <span class="text-muted d-block mt-1" style="font-size: 11px;">
                                Submitted: @req.CreatedAt.ToLocalTime().ToString("g")
                            </span>
                        </div>
                    </div>

                    <div class="alert-glass p-3 mb-3" style="font-size: 13px; background: rgba(0,0,0,0.15);">
                        <div class="mb-2">
                            <strong>Date Range:</strong> <span class="text-white">@req.StartDate.ToLocalTime().ToString("d")</span> to <span class="text-white">@req.EndDate.ToLocalTime().ToString("d")</span>
                        </div>
                        <div class="mb-2">
                            <strong>Reason:</strong> <p class="text-muted mb-0 italic mt-1" style="line-height: 1.4;">"@req.Reason"</p>
                        </div>
                        @if (!string.IsNullOrEmpty(req.AttachmentUrl))
                        {
                            <div class="mt-2">
                                <a href="@GetAbsoluteAttachmentUrl(req.AttachmentUrl)" target="_blank" class="text-decoration-none fw-bold" style="color: var(--colors-focus-outer);">
                                    <i class="bi bi-file-pdf-fill"></i> View/Download PDF Attachment
                                </a>
                            </div>
                        }
                    </div>

                    @* Review Form *@
                    <div class="border-top pt-3 border-secondary" style="border-top-style: dashed !important;">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-semibold mb-1">ADMINISTRATOR NOTE (MIN. 10 CHARACTERS)</label>
                            <textarea class="form-input-dark" style="min-height: 60px; font-size: 13px;"
                                      @bind="notes[req.Id]"
                                      placeholder="Provide notes/reasoning for approval or rejection... (minimum 10 characters)"></textarea>
                            @if (notes.ContainsKey(req.Id) && !string.IsNullOrEmpty(notes[req.Id]) && notes[req.Id].Length < 10)
                            {
                                <span class="text-danger small mt-1 d-block" style="font-size: 11px;">
                                    <i class="bi bi-exclamation-circle"></i> Note must be at least 10 characters. (Current: @notes[req.Id].Length)
                                </span>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <button @onclick="() => ReviewRequest(req.Id, true)"
                                    disabled="@(isSubmitting || !IsValidNote(req.Id))"
                                    class="btn-premium py-2 flex-grow-1">
                                <i class="bi bi-check-circle"></i> Approve Leave
                            </button>
                            <button @onclick="() => ReviewRequest(req.Id, false)"
                                    disabled="@(isSubmitting || !IsValidNote(req.Id))"
                                    class="btn-premium-outline py-2 flex-grow-1">
                                <i class="bi bi-x-circle"></i> Reject Leave
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<LeaveRequestResponseDto> pendingRequests = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? message;

    // Dict to map LeaveRequest.Id to AdminNote
    private Dictionary<int, string> notes = new();

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("authStorage.getToken");
        if (string.IsNullOrEmpty(token) || token == "null")
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadPending(token);
    }

    private async Task LoadPending(string token)
    {
        isLoading = true;
        pendingRequests.Clear();
        notes.Clear();
        StateHasChanged();

        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, "api/admin/leave/pending");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ApiResponse<List<LeaveRequestResponseDto>>>();
                if (body != null && body.Success && body.Data != null)
                {
                    pendingRequests = body.Data;
                    foreach (var item in pendingRequests)
                    {
                        notes[item.Id] = string.Empty;
                    }
                }
            }
            else
            {
                message = $"❌ Failed to load pending requests ({res.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsValidNote(int id)
    {
        return notes.ContainsKey(id) && !string.IsNullOrWhiteSpace(notes[id]) && notes[id].Trim().Length >= 10;
    }

    private async Task ReviewRequest(int id, bool approve)
    {
        if (!IsValidNote(id) || isSubmitting) return;

        isSubmitting = true;
        message = approve ? "⏳ Approving leave request..." : "⏳ Rejecting leave request...";
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            var reviewReq = new LeaveRequestReviewRequest
            {
                AdminNote = notes[id].Trim()
            };

            var endpoint = approve ? $"api/admin/leave/{id}/approve" : $"api/admin/leave/{id}/reject";
            var reqMessage = new HttpRequestMessage(HttpMethod.Put, endpoint);
            reqMessage.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            reqMessage.Content = JsonContent.Create(reviewReq);

            var res = await Http.SendAsync(reqMessage);
            var body = await res.Content.ReadFromJsonAsync<ApiResponse<string>>();

            if (res.IsSuccessStatusCode && body != null && body.Success)
            {
                message = approve ? "✅ Leave request approved successfully!" : "✅ Leave request rejected.";
                await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
                await LoadPending(token);
            }
            else
            {
                message = $"❌ {body?.Message ?? "Action failed."}";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Connection error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetAbsoluteAttachmentUrl(string relativeUrl)
    {
        var baseUri = Http.BaseAddress?.ToString() ?? "http://localhost:5158/";
        return $"{baseUri.TrimEnd('/')}/{relativeUrl.TrimStart('/')}";
    }
}
