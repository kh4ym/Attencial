@page "/login"
@layout Layout.MainLayout
@inject AuthService AuthService
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Login – Attencial</PageTitle>

<div class="login-wrapper">

    <div class="login-card">

        @* ── Logo ── *@
        <div class="login-logo">
            <span class="logo-icon">📋</span>
            <h1 class="logo-text">Attencial</h1>
            <p class="logo-sub">Attendance Management System</p>
        </div>

        @* ── Error Message ── *@
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">
                ⚠️ @errorMessage
            </div>
        }

        @* ── Login Form ── *@
        <div class="form-group">
            <label class="form-label">Email Address</label>
            <input class="form-input"
                   type="email"
                   placeholder="you@example.com"
                   @bind="email"
                   @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label class="form-label">Password</label>
            <input class="form-input"
                   type="password"
                   placeholder="••••••••"
                   @bind="password"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
        </div>

        <button class="login-btn"
                @onclick="HandleLogin"
                disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner"></span>
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign In</span>
            }
        </button>

    </div>

</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        // Basic validation
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your email and password.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        var request = new LoginRequest
        {
            Email = email,
            Password = password
        };

        var result = await AuthService.LoginAsync(request);

        if (result is null)
        {
            errorMessage = "Invalid email or password. Please try again.";
            isLoading = false;
            return;
        }

        // Notify Blazor the user is now logged in
        await AuthStateProvider.NotifyUserLoggedIn();

        // Redirect to the correct dashboard based on role
        var destination = result.Role switch
        {
            "Student" => "/student/dashboard",
            "Professor" => "/professor/dashboard",
            "Admin" => "/admin/dashboard",
            _ => "/"
        };

        Nav.NavigateTo(destination);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }
}