@page "/dashboard"
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Dashboard — Attencial</PageTitle>

@if (isLoading)
{
    @* Skeleton loading state *@
    <div class="animate-fade-in">
        <div class="skeleton skeleton-title mb-4"></div>
        <div class="skeleton skeleton-text" style="width: 40%;"></div>
        <div class="dashboard-grid mt-4">
            @for (int i = 0; i < 4; i++)
            {
                <div class="skeleton skeleton-card"></div>
            }
        </div>
    </div>
}
else if (!isAuthorized)
{
    <div class="text-center py-5 animate-fade-in">
        <div class="spinner-premium"></div>
        <p class="text-muted">Redirecting to login...</p>
    </div>
}
else
{
    @* Error banner *@
    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="alert-glass mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span class="small text-start">@loadError</span>
        </div>
    }

    @* Welcome banner *@
    <div class="animate-fade-in mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="text-muted mb-1" style="font-size: 14px; font-weight: 600;">
                    <span class="live-pulse"></span> Live Dashboard
                </p>
                <h2 class="display-lg mb-1" id="greetingText">Good morning</h2>
                <p class="text-muted fs-6">@userEmail</p>
            </div>
            <div class="d-flex gap-2">
                <a href="enroll" class="btn-premium-outline">
                    <i class="bi bi-person-bounding-box"></i> Face Enrollment
                </a>
                <button class="btn-premium" @onclick="RefreshData">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    @* Stat Cards *@
    <div class="dashboard-grid animate-fade-in delay-1">
        @* Card 1: Enrollment Status *@
        <div class="stat-card tilt-card">
            <div class="card-glare"></div>
            <div class="stat-icon" style="background: rgba(230, 0, 35, 0.08); color: var(--colors-primary);">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="stat-label">Face Enrollment</div>
            <div class="stat-value" style="font-size: 28px;" id="statEnrollment">
                @enrollmentStatus
            </div>
            <div class="stat-change @(isEnrolled ? "stat-change-up" : "stat-change-down")">
                <i class="bi bi-@(isEnrolled ? "check-circle-fill" : "exclamation-circle-fill")"></i>
                @(isEnrolled ? "Ready for attendance" : "Enrollment required")
            </div>
        </div>

        @* Card 2: Total Courses *@
        <div class="stat-card tilt-card">
            <div class="card-glare"></div>
            <div class="stat-icon" style="background: rgba(67, 94, 229, 0.08); color: var(--colors-focus-outer);">
                <i class="bi bi-book-fill"></i>
            </div>
            <div class="stat-label">Total Courses</div>
            <div class="stat-value" id="statCourses">0</div>
            <div class="stat-change stat-change-up">
                <i class="bi bi-arrow-up-short"></i> Active this semester
            </div>
        </div>

        @* Card 3: Attendance Rate *@
        <div class="stat-card tilt-card">
            <div class="card-glare"></div>
            <div class="stat-icon" style="background: rgba(16, 60, 37, 0.08); color: var(--colors-success-deep);">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="stat-label">Attendance Rate</div>
            <div class="stat-value" id="statAttendance">0<small style="font-size: 18px;">%</small></div>
            <div class="stat-change stat-change-up">
                <i class="bi bi-check-circle-fill"></i> Across all courses
            </div>
        </div>

        @* Card 4: Sessions Attended *@
        <div class="stat-card tilt-card">
            <div class="card-glare"></div>
            <div class="stat-icon" style="background: rgba(255, 147, 30, 0.08); color: #ff931e;">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <div class="stat-label">Sessions Attended</div>
            <div class="stat-value" id="statSessions">0</div>
            <div class="stat-change stat-change-up">
                <i class="bi bi-clock-fill"></i> This semester
            </div>
        </div>
    </div>

    @* Course Attendance List for Students *@
    @if (userRole == "Student")
    {
        <div class="mt-4 animate-fade-in delay-2">
            <h3 class="heading-lg mb-3" style="font-family: 'Manrope', sans-serif; font-weight: 700; color: white; display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-journal-check" style="color: var(--colors-primary);"></i>
                My Courses & Attendance
            </h3>

            @if (studentSummary is null || studentSummary.CourseAttendance.Count == 0)
            {
                <div class="feature-card-soft text-center py-5">
                    <i class="bi bi-journal-x text-muted mb-2 animate-float" style="font-size: 2.5rem; display: block;"></i>
                    <p class="text-muted">You are not currently enrolled in any courses.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var course in studentSummary.CourseAttendance)
                    {
                        var statusColor = course.Status == "Green" ? "#2ecc71" : course.Status == "Yellow" ? "#f1c40f" : "#dc3545";
                        var statusBg = course.Status == "Green" ? "rgba(46, 204, 113, 0.08)" : course.Status == "Yellow" ? "rgba(241, 196, 15, 0.08)" : "rgba(220, 53, 69, 0.08)";
                        var isExpanded = expandedCourses.ContainsKey(course.CourseId) && expandedCourses[course.CourseId];

                        <div class="col-md-6">
                            <div class="feature-card-soft h-100 d-flex flex-column" style="transition: border-color 0.3s; border-color: @(isExpanded ? statusColor : "var(--colors-hairline)") !important;">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <span class="badge-custom mb-2" style="background: @statusBg; color: @statusColor; border: 1px solid rgba(255,255,255,0.05);">
                                            @course.CourseCode
                                        </span>
                                        <h5 class="fw-bold mb-1 text-white" style="font-family: 'Manrope', sans-serif;">@course.CourseName</h5>
                                        <p class="text-muted small mb-0">Prof. @course.ProfessorName</p>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold fs-4" style="color: @statusColor; font-family: 'Manrope', sans-serif;">@course.Percentage%</span>
                                        <div class="text-muted small">@course.AttendedSessions / @course.TotalSessions classes</div>
                                    </div>
                                </div>

                                @* Progress Bar *@
                                <div class="progress-bar-track mb-3" style="height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px;">
                                    <div class="progress-bar-fill" style="height: 100%; width: @(course.Percentage)%; background: @statusColor; border-radius: 3px;"></div>
                                </div>

                                @* Expandable missed sessions block *@
                                <div class="mt-auto pt-3" style="border-top: 1px dashed rgba(255, 255, 255, 0.06);">
                                    @if (course.MissedSessions.Count == 0)
                                    {
                                        <div class="d-flex align-items-center gap-2 text-success small">
                                            <i class="bi bi-patch-check-fill"></i>
                                            <span>100% Perfect Attendance! Keep it up.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-clean d-flex align-items-center justify-content-between w-100 text-muted small" 
                                                @onclick="() => ToggleCourse(course.CourseId)">
                                            <span style="font-size: 13px;">
                                                <i class="bi bi-exclamation-triangle-fill" style="color: #f1c40f; margin-right: 4px;"></i>
                                                Missed @course.MissedSessions.Count @(course.MissedSessions.Count == 1 ? "session" : "sessions")
                                            </span>
                                            <span style="font-size: 13px;">
                                                @(isExpanded ? "Hide Details" : "View Dates")
                                                <i class="bi bi-chevron-@(isExpanded ? "up" : "down") ms-1"></i>
                                            </span>
                                        </button>

                                        @if (isExpanded)
                                        {
                                            <div class="mt-3 animate-slide-up" style="background: rgba(0, 0, 0, 0.15); border-radius: var(--rounded-sm); padding: 8px 12px; max-height: 120px; overflow-y: auto;">
                                                <table class="table table-sm table-borderless mb-0 text-muted" style="font-size: 12px;">
                                                    <tbody>
                                                        @foreach (var session in course.MissedSessions)
                                                        {
                                                            <tr>
                                                                <td style="color: var(--colors-primary);"><i class="bi bi-x-circle-fill"></i> Missed</td>
                                                                <td class="text-end">@session.Date.ToLocalTime().ToString("MMM dd, yyyy · hh:mm tt")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* Quick Actions + System Status *@
    <div class="row g-4 mt-3 animate-fade-in delay-2">
        <div class="col-md-5">
            <div class="course-card h-100">
                <h4 class="heading-md mb-3">
                    <i class="bi bi-lightning-charge-fill" style="color: var(--colors-primary);"></i>
                    Quick Actions
                </h4>
                <div class="d-flex flex-column gap-2">
                    <a href="enroll" class="btn-premium-outline w-100 text-start justify-content-start">
                        <i class="bi bi-camera-fill me-2"></i>
                        <span>Enroll / Update Face</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                    <button class="btn-premium-outline w-100 text-start justify-content-start" @onclick="RefreshData">
                        <i class="bi bi-person-check-fill me-2"></i>
                        <span>Refresh Stats</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="course-card h-100">
                <h4 class="heading-md mb-3">
                    <i class="bi bi-hdd-stack-fill" style="color: var(--colors-focus-outer);"></i>
                    System Status
                </h4>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-cloud-check-fill me-2" style="color: var(--colors-success-deep);"></i>AWS Rekognition</span>
                        <span class="badge-custom badge-success">Online</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-database-fill-check me-2" style="color: var(--colors-success-deep);"></i>Database</span>
                        <span class="badge-custom badge-success">Connected</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-shield-lock-fill me-2" style="color: var(--colors-success-deep);"></i>API Status</span>
                        <span class="badge-custom badge-success"><span class="live-pulse"></span>Operational</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-person-badge-fill me-2"></i>Your Role</span>
                        <span class="badge-custom" style="background: rgba(230, 0, 35, 0.08); color: var(--colors-primary);">@userRole</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <p class="text-center text-muted mt-5 animate-fade-in delay-3" style="font-size: 13px;">
        <i class="bi bi-shield-check"></i> Secured by AWS Rekognition &middot; JWT Authentication &middot; End-to-End Encryption
    </p>
}

@code {
    private bool isAuthorized = false;
    private bool isLoading = true;
    private string userEmail = string.Empty;
    private string userRole = "User";
    private string enrollmentStatus = "Unknown";
    private bool isEnrolled = false;
    private string? loadError = null;
    private int totalCourses = 0;
    private int attendanceRate = 0;
    private int sessionsAttended = 0;

    // Student stats
    private StudentAttendanceSummaryDto? studentSummary;
    private Dictionary<int, bool> expandedCourses = new();
    private bool hasAnimated = false;

    private void ToggleCourse(int courseId)
    {
        if (expandedCourses.ContainsKey(courseId))
            expandedCourses[courseId] = !expandedCourses[courseId];
        else
            expandedCourses[courseId] = true;
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("authStorage.getToken");

        if (string.IsNullOrEmpty(token) || token == "null" || token == "undefined")
        {
            Nav.NavigateTo("/login");
            return;
        }

        isAuthorized = true;
        await LoadDashboardData(token);
    }

    private async Task LoadDashboardData(string token)
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        try
        {
            // Fetch user info from /api/auth/me
            var userRequest = new HttpRequestMessage(HttpMethod.Get, "api/auth/me");
            userRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var userResponse = await Http.SendAsync(userRequest);

            if (userResponse.IsSuccessStatusCode)
            {
                var json = await userResponse.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                userEmail = data.GetProperty("email").GetString() ?? string.Empty;
                userRole = data.GetProperty("role").GetString() ?? "User";
            }

            // Fetch enrollment status from /api/enrollment/status
            var enrollRequest = new HttpRequestMessage(HttpMethod.Get, "api/enrollment/status");
            enrollRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var enrollResponse = await Http.SendAsync(enrollRequest);

            if (enrollResponse.IsSuccessStatusCode)
            {
                var json = await enrollResponse.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                isEnrolled = data.GetProperty("isEnrolled").GetBoolean();
                enrollmentStatus = isEnrolled ? "Active" : "Pending";
            }
            else
            {
                loadError = $"Server returned {enrollResponse.StatusCode} when checking enrollment.";
            }

            // If user is a student, fetch student statistics
            if (userRole == "Student")
            {
                var attendanceRequest = new HttpRequestMessage(HttpMethod.Get, "api/students/me/attendance");
                attendanceRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                var attendanceResponse = await Http.SendAsync(attendanceRequest);

                if (attendanceResponse.IsSuccessStatusCode)
                {
                    var resDto = await attendanceResponse.Content.ReadFromJsonAsync<ApiResponse<StudentAttendanceSummaryDto>>();
                    studentSummary = resDto?.Data;

                    if (studentSummary is not null)
                    {
                        totalCourses = studentSummary.TotalCourses;
                        attendanceRate = (int)Math.Round(studentSummary.OverallPercentage);
                        sessionsAttended = studentSummary.PresentSessions;
                    }
                }
                else
                {
                    loadError = $"Failed to load student attendance statistics. Status: {attendanceResponse.StatusCode}";
                }
            }
        }
        catch (Exception ex)
        {
            loadError = $"Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && isAuthorized && !hasAnimated)
        {
            hasAnimated = true;
            await JS.InvokeVoidAsync("attencialAnimations.animateCounter", "statCourses", totalCourses, 1500);
            await JS.InvokeVoidAsync("attencialAnimations.animateCounter", "statAttendance", attendanceRate, 1800);
            await JS.InvokeVoidAsync("attencialAnimations.animateCounter", "statSessions", sessionsAttended, 1600);

            var hour = DateTime.Now.Hour;
            var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
            await JS.InvokeVoidAsync("attencialAnimations.scrambleText", "greetingText", greeting, 800);

            await JS.InvokeVoidAsync("attencialAnimations.initTiltCards");
        }
    }

    private async Task RefreshData()
    {
        var token = await JS.InvokeAsync<string>("authStorage.getToken");
        if (!string.IsNullOrEmpty(token))
        {
            hasAnimated = false;
            await LoadDashboardData(token);
            await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
        }
    }
}
