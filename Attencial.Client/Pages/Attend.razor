@page "/attend"
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Mark Attendance — Attencial</PageTitle>

<div class="feature-card-soft animate-fade-in-scale w-100 mx-auto" style="max-width: 500px;">
    @if (isValidating)
    {
        <div class="text-center py-5">
            <div class="spinner-premium"></div>
            <p class="text-secondary mt-3 mb-0">Verifying attendance link...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(tokenError))
    {
        <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 animate-float"
                 style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(220, 53, 69, 0.1) !important; color: #dc3545 !important;">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <h3 class="h4 fw-bold mb-2">Invalid or Expired Link</h3>
            <p class="text-secondary small mb-4">@tokenError</p>
            <button class="btn-premium py-2 px-4" @onclick="GoHome">
                <i class="bi bi-house-door-fill"></i> Go to Dashboard
            </button>
        </div>
    }
    else if (isSuccess)
    {
        <div class="text-center py-5 animate-scale-bounce">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 animate-float"
                 style="width: 75px; height: 75px; font-size: 2.5rem; background: rgba(40, 167, 69, 0.12) !important; color: #28a745 !important; border: 2px solid rgba(40, 167, 69, 0.25);">
                <i class="bi bi-patch-check-fill"></i>
            </div>
            <h2 class="h3 fw-bold mb-1" style="color: var(--colors-ink);">Attendance Marked!</h2>
            <p class="text-secondary small mb-4">Your face was successfully verified by AWS Rekognition.</p>

            <div class="alert-glass text-start mx-auto p-3 mb-4" style="max-width: 380px; font-size: 13px;">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Student:</span>
                    <span class="fw-semibold">@responseDto?.StudentName</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Roll Number:</span>
                    <span class="fw-semibold">@responseDto?.RollNumber</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Course:</span>
                    <span class="fw-semibold">@responseDto?.CourseCode — @responseDto?.CourseName</span>
                </div>
                <div class="d-flex justify-content-between border-top pt-2 border-secondary" style="border-top-style: dashed !important;">
                    <span class="text-muted">Time:</span>
                    <span class="fw-semibold">@responseDto?.MarkedAt.ToLocalTime().ToString("g")</span>
                </div>
            </div>

            <button class="btn-premium-outline py-2 px-4" @onclick="GoHome">
                <i class="bi bi-house-door"></i> Back to Dashboard
            </button>
        </div>
    }
    else
    {
        @* ── MAIN CAMERA FLOW ── *@
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2"
                 style="width: 45px; height: 45px; font-size: 1.3rem; background: rgba(230, 0, 35, 0.1) !important; color: var(--colors-primary) !important;">
                <i class="bi bi-camera-fill"></i>
            </div>
            <h3 class="h4 fw-bold mb-1">Verify Face</h3>
            <p class="text-secondary small mb-0">Course: <span class="fw-semibold text-white">@sessionInfo?.CourseCode — @sessionInfo?.CourseName</span></p>
            <p class="text-secondary small" style="font-size: 11px;">Professor: @sessionInfo?.ProfessorName</p>
        </div>

        @if (message is not null)
        {
            @if (message.StartsWith("❌"))
            {
                <div class="alert-glass mb-4 d-flex align-items-start gap-2 animate-fade-in">
                    <i class="bi bi-exclamation-triangle-fill mt-1" style="color: var(--colors-primary);"></i>
                    <span class="small text-start">@message.Replace("❌ ", "")</span>
                </div>
            }
            else
            {
                <div class="alert-glass-success mb-4 d-flex align-items-start gap-2 animate-fade-in">
                    <i class="bi bi-info-circle-fill mt-1"></i>
                    <span class="small text-start">@message</span>
                </div>
            }
        }

        <div class="text-center mb-4 position-relative mx-auto" style="max-width: 400px;">
            <div class="position-relative overflow-hidden rounded-3" style="border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md); height: 300px;">
                <video id="camera" autoplay width="100%" height="100%" style="object-fit: cover; transform: scaleX(-1);"></video>

                @* Scan line animation *@
                @if (cameraStarted && !isSubmitting)
                {
                    <div class="camera-scan-line"></div>
                }

                @if (cameraStarted)
                {
                    <div class="camera-overlay-container">
                        @* Face guide outline *@
                        <svg viewBox="0 0 100 100" class="position-absolute" style="width: 190px; height: 230px; color: rgba(255, 255, 255, 0.2); pointer-events: none;">
                            <path d="M 50 15 C 32 15, 30 50, 32 70 C 35 85, 45 92, 50 92 C 55 92, 65 85, 68 70 C 70 50, 68 15, 50 15 Z" fill="none" stroke="currentColor" stroke-dasharray="3,3" stroke-width="1" />
                        </svg>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            @if (!cameraStarted)
            {
                <button @onclick="StartCamera" class="btn-premium py-2 px-4 w-100">
                    <i class="bi bi-camera-video-fill"></i> Open Camera
                </button>
            }
            else
            {
                <button @onclick="MarkAttendance" disabled="@isSubmitting" class="btn-premium py-2 px-4 w-100 animate-pulse-glow">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Verifying Face...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle"></i>
                        <span>Verify & Mark Attendance</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private string? token;
    private bool isValidating = true;
    private string? tokenError;
    
    private bool cameraStarted = false;
    private bool isSubmitting = false;
    private bool isSuccess = false;
    
    private string? message;
    
    private AttendanceTokenValidateResponse? sessionInfo;
    private AttendanceMarkResponse? responseDto;

    protected override async Task OnInitializedAsync()
    {
        // Parse token from query string manually: ?token=xxx
        var uri = Nav.Uri;
        var queryIndex = uri.IndexOf('?');
        if (queryIndex >= 0)
        {
            var queryString = uri.Substring(queryIndex + 1);
            var pairs = queryString.Split('&');
            foreach (var pair in pairs)
            {
                var parts = pair.Split('=');
                if (parts.Length == 2 && parts[0] == "token")
                {
                    token = parts[1];
                    break;
                }
            }
        }

        if (string.IsNullOrEmpty(token))
        {
            tokenError = "Missing token parameter in link. Please scan the QR code again.";
            isValidating = false;
            return;
        }

        await ValidateToken();
    }

    private async Task ValidateToken()
    {
        isValidating = true;
        tokenError = null;

        try
        {
            var res = await Http.GetAsync($"api/attendance/sessions/validate?token={token}");
            
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ApiResponse<AttendanceTokenValidateResponse>>();
                if (body != null && body.Success)
                {
                    sessionInfo = body.Data;
                }
                else
                {
                    tokenError = body?.Message ?? "Validation failed.";
                }
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                tokenError = "Too many page load attempts. You have been temporarily rate limited.";
            }
            else
            {
                var body = await res.Content.ReadFromJsonAsync<ApiResponse<object>>();
                tokenError = body?.Message ?? $"Failed to validate link ({res.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            tokenError = $"Connection error: {ex.Message}";
        }
        finally
        {
            isValidating = false;
        }
    }

    private async Task StartCamera()
    {
        message = null;
        await JS.InvokeVoidAsync("cameraInterop.startCamera", "camera");
        cameraStarted = true;
    }

    private async Task MarkAttendance()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        message = "⏳ Capturing frame and identifying face...";
        StateHasChanged();

        try
        {
            // Capture image base64
            var base64 = await JS.InvokeAsync<string>("cameraInterop.captureFrame", "camera");
            
            // Clean the base64 prefix if exists
            if (base64.Contains(","))
            {
                base64 = base64.Split(',')[1];
            }

            // Get or create unique client-side device ID
            var deviceId = await GetOrCreateDeviceId();

            var request = new AttendanceMarkRequest
            {
                Token = token!,
                DeviceId = deviceId,
                Image = base64
            };

            var res = await Http.PostAsJsonAsync("api/attendance/mark", request);
            var body = await res.Content.ReadFromJsonAsync<ApiResponse<AttendanceMarkResponse>>();

            if (res.IsSuccessStatusCode && body != null && body.Success)
            {
                responseDto = body.Data;
                isSuccess = true;
                await JS.InvokeVoidAsync("cameraInterop.stopCamera");
                cameraStarted = false;
                await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
            }
            else
            {
                message = $"❌ {body?.Message ?? "Face verification failed. Please try again."}";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Connection error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task<string> GetOrCreateDeviceId()
    {
        var deviceId = await JS.InvokeAsync<string>("localStorage.getItem", "attencial_device_id");
        if (string.IsNullOrEmpty(deviceId))
        {
            deviceId = Guid.NewGuid().ToString();
            await JS.InvokeVoidAsync("localStorage.setItem", "attencial_device_id", deviceId);
        }
        return deviceId;
    }

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        if (cameraStarted)
        {
            try
            {
                await JS.InvokeVoidAsync("cameraInterop.stopCamera");
            }
            catch { }
        }
    }
}
