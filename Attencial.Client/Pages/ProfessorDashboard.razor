@page "/professor-dashboard"
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@using System.Text.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Professor Analytics — Attencial</PageTitle>

@if (!isAuthorized)
{
    <div class="text-center py-5 animate-fade-in">
        <div class="spinner-premium"></div>
        <p class="text-muted">Checking authorization...</p>
    </div>
}
else if (isProfileMissing)
{
    <div class="row justify-content-center animate-fade-in py-5">
        <div class="col-md-6">
            <div class="feature-card-soft p-4 text-center">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 animate-float"
                     style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(230, 0, 35, 0.1) !important; color: var(--colors-primary) !important;">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <h4 class="fw-bold mb-2">Professor Profile Required</h4>
                <p class="text-muted small mb-4">You need a professor profile to access analytics. Please go to the Sessions page to create one first.</p>
                <a href="/session" class="btn-premium d-inline-block">Go to Sessions</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="animate-fade-in">
        @* Header *@
        <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <p class="text-muted mb-1" style="font-size: 14px; font-weight: 600;">
                    <span class="live-pulse"></span> Analytics Panel
                </p>
                <h2 class="display-lg mb-1" style="font-family: 'Manrope', sans-serif; font-weight: 800;">Course Analytics</h2>
                <p class="text-muted fs-6">Monitor session histories, export attendance sheets, and check security flags.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-glass mb-4 d-flex align-items-start gap-2 animate-fade-in">
                <i class="bi bi-exclamation-triangle-fill mt-1" style="color: var(--colors-primary);"></i>
                <span class="small">@errorMessage</span>
            </div>
        }

        @* Course Selector Card *@
        <div class="feature-card-soft mb-4">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold mb-2" style="letter-spacing: 0.05em;">SELECT COURSE ANALYTICS</label>
                    <select class="form-input-dark" @onchange="OnCourseSelected" value="@selectedCourseId">
                        <option value="0">-- Choose a Course --</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.CourseCode — @c.Name</option>
                        }
                    </select>
                </div>
                @if (selectedCourseId > 0 && sessions.Count > 0)
                {
                    <div class="col-md-6 text-md-end">
                        <a href="@GetDownloadUrl()" target="_blank" class="btn-premium d-inline-flex align-items-center gap-2" style="text-decoration: none;">
                            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                            <span>Download CSV Report</span>
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (selectedCourseId > 0)
        {
            @if (isLoadingData)
            {
                <div class="text-center py-5">
                    <div class="spinner-premium"></div>
                    <p class="text-muted small mt-2">Loading course records...</p>
                </div>
            }
            else
            {
                @* Summary Stats *@
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon" style="background: rgba(67, 94, 229, 0.08); color: var(--colors-focus-outer);">
                                <i class="bi bi-calendar-event-fill"></i>
                            </div>
                            <div class="stat-label">Total Sessions</div>
                            <div class="stat-value">@sessions.Count</div>
                            <div class="stat-change stat-change-up">
                                <i class="bi bi-plus-circle-fill"></i> Created this semester
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon" style="background: rgba(46, 204, 113, 0.08); color: #2ecc71;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div class="stat-label">Avg Attendance</div>
                            <div class="stat-value">@GetAverageAttendanceRate()%</div>
                            <div class="stat-change stat-change-up">
                                <i class="bi bi-check-circle-fill"></i> Overall class participation
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon" style="background: @(abuseLogs.Count > 0 ? "rgba(230,0,35,0.08)" : "rgba(46,204,113,0.08)"); color: @(abuseLogs.Count > 0 ? "var(--colors-primary)" : "#2ecc71");">
                                <i class="bi bi-@(abuseLogs.Count > 0 ? "shield-fill-exclamation" : "shield-fill-check")"></i>
                            </div>
                            <div class="stat-label">Security Alerts</div>
                            <div class="stat-value" style="color: @(abuseLogs.Count > 0 ? "var(--colors-primary)" : "inherit");">@abuseLogs.Count</div>
                            <div class="stat-change @(abuseLogs.Count > 0 ? "stat-change-down" : "stat-change-up")">
                                <i class="bi bi-@(abuseLogs.Count > 0 ? "exclamation-triangle-fill" : "check-circle-fill")"></i>
                                @(abuseLogs.Count > 0 ? "Flagged scans detected" : "No security issues")
                            </div>
                        </div>
                    </div>
                </div>

                @* Tabs Section *@
                <div class="feature-card-soft">
                    <div class="d-flex gap-3 mb-4 border-bottom pb-2" style="border-color: rgba(255,255,255,0.08) !important;">
                        <button class="btn-clean pb-2 fw-semibold" 
                                style="font-size: 15px; color: @(activeTab == "sessions" ? "white" : "var(--colors-text-muted)"); border-bottom: 2px solid @(activeTab == "sessions" ? "var(--colors-primary)" : "transparent");"
                                @onclick='() => activeTab = "sessions"'>
                            Session History
                        </button>
                        <button class="btn-clean pb-2 fw-semibold" 
                                style="font-size: 15px; color: @(activeTab == "security" ? "white" : "var(--colors-text-muted)"); border-bottom: 2px solid @(activeTab == "security" ? "var(--colors-primary)" : "transparent");"
                                @onclick='() => activeTab = "security"'>
                            Security Logs (@abuseLogs.Count)
                        </button>
                    </div>

                    @if (activeTab == "sessions")
                    {
                        @if (sessions.Count == 0)
                        {
                            <div class="text-center py-5 opacity-50">
                                <i class="bi bi-clock-history mb-2" style="font-size: 2.2rem; display: block;"></i>
                                <p class="small mb-0">No attendance sessions found for this course.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-striped table-hover mb-0" style="font-size: 14px; background: transparent;">
                                    <thead>
                                        <tr style="border-color: rgba(255,255,255,0.08);">
                                            <th>SESSION ID</th>
                                            <th>START TIME</th>
                                            <th>END TIME</th>
                                            <th>STATUS</th>
                                            <th>PRESENT</th>
                                            <th>ABSENT</th>
                                            <th class="text-end">ATTENDANCE RATE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in sessions)
                                        {
                                            var rateColor = s.AttendanceRate >= 75.0 ? "#2ecc71" : s.AttendanceRate >= 65.0 ? "#f1c40f" : "#dc3545";
                                            <tr style="border-color: rgba(255,255,255,0.04);">
                                                <td class="fw-semibold">#@s.SessionId</td>
                                                <td>@s.StartTime.ToLocalTime().ToString("yyyy-MM-dd · hh:mm tt")</td>
                                                <td>
                                                    @if (s.EndTime.HasValue)
                                                    {
                                                        @s.EndTime.Value.ToLocalTime().ToString("hh:mm tt")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (s.IsActive)
                                                    {
                                                        <span class="badge-custom badge-success"><span class="live-pulse"></span> Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-custom" style="background: rgba(255,255,255,0.05); color: #888;">Ended</span>
                                                    }
                                                </td>
                                                <td style="color: #2ecc71;" class="fw-semibold">@s.PresentCount</td>
                                                <td style="color: #dc3545;">@s.AbsentCount</td>
                                                <td class="text-end fw-bold" style="color: @rateColor;">@s.AttendanceRate%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (activeTab == "security")
                    {
                        @if (abuseLogs.Count == 0)
                        {
                            <div class="text-center py-5 text-success">
                                <i class="bi bi-shield-fill-check mb-2" style="font-size: 2.5rem; display: block;"></i>
                                <h5 class="fw-bold mb-1">Course Secured</h5>
                                <p class="small text-muted mb-0">No unauthorized scanning attempts detected.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-striped table-hover mb-0" style="font-size: 14px; background: transparent;">
                                    <thead>
                                        <tr style="border-color: rgba(255,255,255,0.08);">
                                            <th>SESSION ID</th>
                                            <th>STUDENT</th>
                                            <th>ROLL NUMBER</th>
                                            <th>FLAG TYPE</th>
                                            <th>DETAILS</th>
                                            <th>DEVICE ID</th>
                                            <th>IP ADDRESS</th>
                                            <th class="text-end">LOGGED AT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in abuseLogs)
                                        {
                                            <tr style="border-color: rgba(255,255,255,0.04);">
                                                <td>#@l.SessionId</td>
                                                <td class="fw-semibold text-white">@l.StudentName</td>
                                                <td>@l.RollNumber</td>
                                                <td>
                                                    <span class="badge-custom" style="background: rgba(230,0,35,0.1); color: var(--colors-primary);">
                                                        @l.AbuseType
                                                    </span>
                                                </td>
                                                <td class="text-muted small">@l.Details</td>
                                                <td><code style="font-size: 11px;">@l.DeviceId</code></td>
                                                <td>@l.IpAddress</td>
                                                <td class="text-end text-muted">@l.LoggedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            }
        }
        else
        {
            @* Empty State *@
            <div class="feature-card-soft text-center py-5 animate-fade-in" style="opacity: 0.7;">
                <i class="bi bi-graph-up text-muted mb-3" style="font-size: 3rem; display: block;"></i>
                <h5 class="fw-semibold text-white">No Course Selected</h5>
                <p class="text-muted small mb-0">Please choose one of your courses from the dropdown above to display analytics.</p>
            </div>
        }
    </div>
}

@code {
    private bool isAuthorized = false;
    private bool isProfileMissing = false;
    private string? errorMessage;
    private int selectedCourseId = 0;
    private string activeTab = "sessions";
    private string jwtToken = string.Empty;

    private List<CourseItem> courses = new();
    private List<ProfessorSessionDto> sessions = new();
    private List<AbuseLogResponseDto> abuseLogs = new();
    private bool isLoadingData = false;

    protected override async Task OnInitializedAsync()
    {
        jwtToken = await JS.InvokeAsync<string>("authStorage.getToken");
        if (string.IsNullOrEmpty(jwtToken) || jwtToken == "null")
        {
            Nav.NavigateTo("/login");
            return;
        }

        isAuthorized = true;
        await LoadCourses(jwtToken);
    }

    private async Task LoadCourses(string token)
    {
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Get, "api/attendance/professor/courses");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var res = await Http.SendAsync(req);

            if (res.IsSuccessStatusCode)
            {
                isProfileMissing = false;
                errorMessage = null;
                var json = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                courses = new();
                foreach (var item in data.EnumerateArray())
                {
                    courses.Add(new CourseItem
                    {
                        Id = item.GetProperty("id").GetInt32(),
                        Name = item.GetProperty("name").GetString() ?? "",
                        CourseCode = item.GetProperty("courseCode").GetString() ?? ""
                    });
                }
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "Access denied (403). Your account role is not 'Professor'.";
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                isProfileMissing = true;
            }
            else
            {
                errorMessage = $"Failed to load courses. Status: {res.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }
    }

    private async Task OnCourseSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedCourseId = id;
            if (selectedCourseId > 0)
            {
                await LoadCourseData();
            }
        }
    }

    private async Task LoadCourseData()
    {
        isLoadingData = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            // 1. Fetch Session History
            var sessReq = new HttpRequestMessage(HttpMethod.Get, $"api/professor/courses/{selectedCourseId}/sessions");
            sessReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", jwtToken);
            var sessRes = await Http.SendAsync(sessReq);

            if (sessRes.IsSuccessStatusCode)
            {
                var json = await sessRes.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                sessions = JsonSerializer.Deserialize<List<ProfessorSessionDto>>(data.GetRawText(), new JsonSerializerOptions
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                }) ?? new();
            }
            else
            {
                errorMessage = $"Failed to load session history. ({sessRes.StatusCode})";
            }

            // 2. Fetch Security Logs
            var abuseReq = new HttpRequestMessage(HttpMethod.Get, $"api/professor/courses/{selectedCourseId}/abuselogs");
            abuseReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", jwtToken);
            var abuseRes = await Http.SendAsync(abuseReq);

            if (abuseRes.IsSuccessStatusCode)
            {
                var json = await abuseRes.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var data = doc.RootElement.GetProperty("data");
                abuseLogs = JsonSerializer.Deserialize<List<AbuseLogResponseDto>>(data.GetRawText(), new JsonSerializerOptions
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                }) ?? new();
            }
            else
            {
                errorMessage = (errorMessage ?? "") + $" Failed to load security logs. ({abuseRes.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading course data: {ex.Message}";
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

    private string GetDownloadUrl()
    {
        return $"{Http.BaseAddress}api/professor/courses/{selectedCourseId}/export?token={Uri.EscapeDataString(jwtToken)}";
    }

    private double GetAverageAttendanceRate()
    {
        if (sessions.Count == 0) return 100.0;
        var sum = sessions.Sum(s => s.AttendanceRate);
        return Math.Round(sum / sessions.Count, 1);
    }

    private class CourseItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string CourseCode { get; set; } = string.Empty;
    }
}
