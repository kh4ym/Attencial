@page "/register"
@using Attencial.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Sign Up — Attencial</PageTitle>

<div class="auth-page-bg">
    <!-- Logo Header -->
    <div class="d-flex align-items-center justify-content-center gap-2 mb-4 animate-fade-in">
        <i class="bi bi-eye-fill" style="color: var(--colors-primary); font-size: 1.8rem;"></i>
        <span class="fs-4 fw-bold" style="color: var(--colors-ink); font-family: 'Manrope', sans-serif; letter-spacing: -0.04em;">
            Attencial
        </span>
    </div>

    <!-- Registration Card -->
    <div class="auth-card animate-fade-in">
        <h2 class="auth-title">Sign up</h2>
        <p class="auth-subtitle">Create an account to start managing attendance.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-glass mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span class="small text-start">@errorMessage</span>
            </div>
        }

        @if (isSuccess)
        {
            <div class="alert-glass-success mb-4 d-flex flex-column gap-3 text-center align-items-center">
                <div class="fs-3"><i class="bi bi-check-circle-fill"></i></div>
                <div class="fw-semibold fs-5">Registration Successful!</div>
                <div class="small text-secondary">Your account has been created. You can now log in.</div>
                <a href="login" class="auth-btn mt-2 text-white text-decoration-none" style="text-shadow: none;">
                    Go to Login
                </a>
            </div>
        }
        else
        {
            <form @onsubmit="HandleRegister">
                <!-- Full Name -->
                <div class="auth-input-wrapper">
                    <i class="bi bi-person auth-input-icon"></i>
                    <input type="text" class="auth-input" placeholder="Enter your full name" @bind="fullName" required />
                </div>

                <!-- Email Address -->
                <div class="auth-input-wrapper">
                    <i class="bi bi-envelope auth-input-icon"></i>
                    <input type="email" class="auth-input" placeholder="Enter your email" @bind="email" required />
                </div>

                <!-- Password -->
                <div class="auth-input-wrapper">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input type="@(showPassword ? "text" : "password")" class="auth-input" placeholder="Create password (min. 6 chars)" 
                           @bind="password" required minlength="6" />
                    <button type="button" class="auth-toggle-pwd" @onclick="TogglePasswordVisibility">
                        @(showPassword ? "Hide" : "Show")
                    </button>
                </div>

                <!-- Role Selection -->
                <div class="auth-input-wrapper">
                    <i class="bi bi-person-badge auth-input-icon"></i>
                    <select class="auth-input form-control-custom" @bind="role">
                        <option value="Student">Student</option>
                        <option value="Professor">Professor</option>
                    </select>
                </div>

                <!-- Conditional Roll Number -->
                @if (role == "Student")
                {
                    <div class="auth-input-wrapper animate-fade-in" style="animation-duration: 0.3s;">
                        <i class="bi bi-hash auth-input-icon"></i>
                        <input type="text" class="auth-input" placeholder="Enter your roll number (e.g. 241871)" @bind="rollNumber" required />
                    </div>
                }

                <!-- Sign Up Button -->
                <button type="submit" class="auth-btn mt-2" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span>Create account</span>
                    }
                </button>
            </form>
        }
    </div>

    <!-- Redirect Links Outside Card -->
    <p class="auth-footer-link animate-fade-in delay-1">
        Already have an account? <a href="login">Log in</a>
    </p>
</div>

@code {
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string role = "Student";
    private string rollNumber = string.Empty;
    
    private bool showPassword = false;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isSuccess = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;

        // Ensure roll number is clean if registering as professor
        var registrationRollNumber = role == "Student" ? rollNumber.Trim() : string.Empty;

        var request = new RegisterRequest
        {
            FullName = fullName.Trim(),
            Email = email.Trim(),
            Password = password,
            Role = role,
            RollNumber = registrationRollNumber
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", request);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<string>>();
                errorMessage = result?.Message ?? "Registration failed. Please check details and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
