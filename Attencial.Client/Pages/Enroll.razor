@page "/enroll"
@using Attencial.Shared.Dtos
@using System.Net.Http.Headers
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Face Enrollment — Attencial</PageTitle>

<div class="feature-card-soft animate-fade-in-scale w-100 mx-auto" style="max-width: 500px;">
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 animate-float"
             style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(230, 0, 35, 0.1) !important; color: var(--colors-primary) !important;">
            <i class="bi bi-person-bounding-box"></i>
        </div>
        <h2 class="h3 fw-bold mb-1">Face Enrollment</h2>
        <p class="text-secondary small">We need exactly 3 photos for accurate recognition. Look straight, then slightly left, then slightly right.</p>
    </div>

    @if (isCheckingStatus)
    {
        <div class="text-center py-5">
            <div class="spinner-premium"></div>
            <p class="text-secondary mb-0">Checking your enrollment status...</p>
        </div>
    }
    else
    {
        @if (message is not null)
        {
            @if (message.StartsWith("❌"))
            {
                <div class="alert-glass mb-4 d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                    <span class="small text-start">@message.Replace("❌ ", "")</span>
                </div>
            }
            else if (message.StartsWith("ℹ️"))
            {
                <div class="alert-glass-success mb-4 d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill mt-1"></i>
                    <span class="small text-start">@message.Replace("ℹ️ ", "")</span>
                </div>
            }
            else if (message.StartsWith("✅"))
            {
                <div class="alert-glass-success mb-4 d-flex align-items-start gap-2 animate-scale-bounce">
                    <i class="bi bi-check-circle-fill mt-1"></i>
                    <span class="small text-start">@message.Replace("✅ ", "")</span>
                </div>
            }
            else
            {
                <div class="alert-glass-success mb-4 d-flex align-items-start gap-2">
                    <i class="bi bi-camera-fill mt-1"></i>
                    <span class="small text-start">@message</span>
                </div>
            }
        }

        <div class="text-center mb-4 position-relative mx-auto" style="max-width: 400px;">
            <div class="position-relative overflow-hidden rounded-3" style="border: 1px solid var(--colors-hairline); border-radius: var(--rounded-md); height: 300px;">
                <video id="camera" autoplay width="100%" height="100%" style="object-fit: cover; transform: scaleX(-1);"></video>

                @* Scan line animation *@
                @if (cameraStarted && photos.Count < 3)
                {
                    <div class="camera-scan-line"></div>
                }

                @if (cameraStarted && photos.Count < 3)
                {
                    <div class="camera-overlay-container">
                        @* Static dotted face guide *@
                        <svg viewBox="0 0 100 100" class="position-absolute" style="width: 190px; height: 230px; color: rgba(255, 255, 255, 0.2); pointer-events: none;">
                            <path d="M 50 15 C 32 15, 30 50, 32 70 C 35 85, 45 92, 50 92 C 55 92, 65 85, 68 70 C 70 50, 68 15, 50 15 Z" fill="none" stroke="currentColor" stroke-dasharray="3,3" stroke-width="1" />
                        </svg>

                        @* Transforming 3D face guide *@
                        <div class="face-guide-3d @GetTiltClass()">
                            <svg viewBox="0 0 100 100" class="face-wireframe">
                                <path d="M 50 15 C 32 15, 30 50, 32 70 C 35 85, 45 92, 50 92 C 55 92, 65 85, 68 70 C 70 50, 68 15, 50 15 Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-dasharray="3,3" />
                            </svg>

                            @if (photos.Count == 1)
                            {
                                <div class="tilt-arrow tilt-left-arrow">
                                    <i class="bi bi-arrow-left-short fs-4 animate-bounce-left"></i>
                                    <span>Tilt Left</span>
                                </div>
                            }
                            else if (photos.Count == 2)
                            {
                                <div class="tilt-arrow tilt-right-arrow">
                                    <i class="bi bi-arrow-right-short fs-4 animate-bounce-right"></i>
                                    <span>Tilt Right</span>
                                </div>
                            }
                            else if (photos.Count == 0)
                            {
                                <div class="tilt-message-straight">
                                    <span>Look Straight</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Step indicators *@
            <div class="d-flex justify-content-center gap-3 mt-3">
                <span class="badge-custom @(photos.Count >= 1 ? "badge-success" : "badge-pending")">
                    <i class="@(photos.Count >= 1 ? "bi bi-check-circle-fill" : "bi bi-circle")"></i> Front
                </span>
                <span class="badge-custom @(photos.Count >= 2 ? "badge-success" : "badge-pending")">
                    <i class="@(photos.Count >= 2 ? "bi bi-check-circle-fill" : "bi bi-circle")"></i> Left
                </span>
                <span class="badge-custom @(photos.Count >= 3 ? "badge-success" : "badge-pending")">
                    <i class="@(photos.Count >= 3 ? "bi bi-check-circle-fill" : "bi bi-circle")"></i> Right
                </span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <button @onclick="StartCamera" disabled="@(cameraStarted || (isEnrolled && daysUntilNextUpdate > 0))" class="btn-premium py-2 px-3">
                <i class="bi bi-camera-video-fill"></i> Open Camera
            </button>

            <button @onclick="CapturePhoto" disabled="@(!cameraStarted || photos.Count >= 3)" class="btn-premium-outline py-2 px-3">
                <i class="bi bi-camera-fill"></i> Capture (@photos.Count/3)
            </button>

            @if (photos.Count == 3)
            {
                <button @onclick="SubmitEnrollment" disabled="@isSubmitting" class="btn-premium py-2 px-3 animate-pulse-glow">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-arrow-up-fill text-white"></i>
                        <span>Submit</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private string GetTiltClass()
    {
        if (photos.Count == 0) return "tilt-front";
        if (photos.Count == 1) return "tilt-left";
        if (photos.Count == 2) return "tilt-right";
        return "tilt-front";
    }

    private List<string> photos = new();
    private bool cameraStarted = false;
    private bool isSubmitting = false;
    private string? message;

    private bool isCheckingStatus = true;
    private bool isEnrolled = false;
    private double daysUntilNextUpdate = 0;
    private DateTime? lastEnrollmentDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadEnrollmentStatus();
    }

    private async Task LoadEnrollmentStatus()
    {
        isCheckingStatus = true;
        message = null;

        try
        {
            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            if (string.IsNullOrEmpty(token))
            {
                message = "❌ You must be logged in to enroll. Please log in first.";
                isCheckingStatus = false;
                return;
            }

            var request = new HttpRequestMessage(HttpMethod.Get, "api/enrollment/status");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<EnrollmentStatusData>>();
                if (result?.Data != null)
                {
                    isEnrolled = result.Data.IsEnrolled;
                    lastEnrollmentDate = result.Data.LastEnrollmentDate;
                    daysUntilNextUpdate = result.Data.DaysUntilNextUpdate;

                    if (isEnrolled && daysUntilNextUpdate > 0)
                    {
                        message = $"❌ You have already enrolled your face. Re-enrollment is locked for {daysUntilNextUpdate} more day(s).";
                    }
                    else if (isEnrolled)
                    {
                        message = $"ℹ️ You are already enrolled. Re-enrolling now will overwrite your previous face template from {lastEnrollmentDate?.ToLocalTime().ToString("d")}.";
                    }
                }
            }
            else
            {
                message = "❌ Failed to load enrollment status from server.";
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Error loading status: {ex.Message}";
        }
        finally
        {
            isCheckingStatus = false;
        }
    }

    private async Task StartCamera()
    {
        await JS.InvokeVoidAsync("cameraInterop.startCamera", "camera");
        cameraStarted = true;
    }

    private async Task CapturePhoto()
    {
        var base64 = await JS.InvokeAsync<string>("cameraInterop.captureFrame", "camera");
        photos.Add(base64);
        message = $"Photo {photos.Count}/3 captured!";

        if (photos.Count == 3)
        {
            await JS.InvokeVoidAsync("cameraInterop.stopCamera");
            message += " Camera stopped. Ready to submit.";
        }
    }

    private async Task SubmitEnrollment()
    {
        isSubmitting = true;
        message = "⏳ Enrolling — indexing your face into AWS Rekognition...";
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("authStorage.getToken");
            if (string.IsNullOrEmpty(token))
            {
                message = "❌ You must be logged in to enroll. Please log in first.";
                return;
            }

            var request = new HttpRequestMessage(HttpMethod.Post, "api/enrollment/enroll");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(new EnrollRequest { Images = photos });

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                message = "✅ Enrollment complete! You can now mark attendance.";
                await JS.InvokeVoidAsync("attencialAnimations.confettiBurst");
                photos.Clear();
                cameraStarted = false;
                await LoadEnrollmentStatus();
            }
            else
            {
                try
                {
                    var result = await response.Content.ReadFromJsonAsync<ApiResponse<string>>();
                    message = $"❌ Enrollment failed: {result?.Message ?? "Unknown error"}";
                }
                catch
                {
                    message = $"❌ Server error (Status: {response.StatusCode}). Check the API console for details.";
                }
                photos.Clear();
                cameraStarted = false;
            }
        }
        catch (Exception ex)
        {
            message = $"❌ Connection error: {ex.Message}";
            photos.Clear();
            cameraStarted = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class EnrollmentStatusData
    {
        public string EnrollmentStatus { get; set; } = string.Empty;
        public bool IsEnrolled { get; set; }
        public DateTime? LastEnrollmentDate { get; set; }
        public double DaysUntilNextUpdate { get; set; }
    }
}
